<% content_for(:title) { t("landing.title") } %>

<%# ═══════════════════════════════════════════════════════════════════════════
    MASTHEAD — the one deep band, carrying the wordmark and the account nav.
    Exactly one <nav> on this page: the footer's locale switcher is a plain
    list, so `within "nav"` in the system tests stays unambiguous.
    ═══════════════════════════════════════════════════════════════════════════ %>
<header class="masthead">
  <div class="masthead-inner">
    <a class="wordmark press-deep" href="<%= root_path %>">aperto<b>.wine</b></a>

    <nav class="flex flex-wrap items-center gap-x-4 gap-y-2" aria-label="<%= t("landing.account_nav") %>">
      <% if signed_in? %>
        <%# A person's name is set in the text face, not shouted in mono caps. %>
        <span class="text-meta text-on-deep-soft"><%= current_user.name %></span>
        <%= button_to t("auth.sign_out"), sign_out_path, method: :delete, class: "btn-wine-deep" %>
      <% else %>
        <a class="link-mono" href="<%= sign_in_path %>"><%= t("landing.sign_in") %></a>
        <a class="btn-wine-deep" href="<%= sign_up_path %>"><%= t("landing.sign_up") %></a>
      <% end %>
    </nav>
  </div>
</header>

<main id="main">
  <%# ═════════════════════════════════════════════════════════════════════════
      HERO — headline column, engraving column. The plate is decorative
      (aria-hidden inside the partial), so the copy carries the meaning.
      ═════════════════════════════════════════════════════════════════════════ %>
  <section class="spread py-10 md:py-16 lg:grid lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-center lg:gap-x-16 lg:py-24" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow"><%= t("landing.hero_tagline") %></p>

      <h1 id="hero-title" class="display-1 press my-6 [&_span]:text-ox-3"><%= t("landing.hero_title_html") %></h1>

      <hr class="rule-section">

      <p class="lede mt-6 md:mt-8"><%= t("landing.hero_subtitle") %></p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn-wine" href="#">
          <%= icon "storefront", variant: "regular", class: "size-4" %>
          <%= t("landing.cta_restaurant") %>
        </a>
        <a class="btn-wine-outline" href="#">
          <%= icon "wine", variant: "regular", class: "size-4" %>
          <%= t("landing.cta_customer") %>
        </a>
      </div>

      <hr class="rule-fine mt-10 md:mt-12">
    </div>

    <%= render "shared/engraving", css: "mt-12 lg:mt-0" %>
  </section>

  <%# ═════════════════════════════════════════════════════════════════════════
      HOW IT WORKS — the tinted band, ruled as a table
      ═════════════════════════════════════════════════════════════════════════ %>
  <section class="band-tint" aria-labelledby="how-title">
    <div class="spread">
      <div class="section-head">
        <h2 id="how-title" class="section-title press"><%= t("landing.how_title") %></h2>
        <span class="leader leader-fine" aria-hidden="true"></span>
        <%# The running head repeats the section's own name; on a narrow screen
            the title already fills the line, so it steps out rather than
            crushing the leader into nothing. %>
        <span class="mono-label hidden shrink-0 text-ox-2 md:inline"><%= t("landing.how_label") %></span>
      </div>

      <ol class="ledger-steps">
        <% t("landing.steps").each_with_index do |step, i| %>
          <li class="ledger-step">
            <span class="step-number num" aria-hidden="true"><%= format("%02d", i + 1) %></span>
            <h3 class="text-h4"><%= step[:title] %></h3>
            <p class="mt-2 text-pretty"><%= step[:description] %></p>
          </li>
        <% end %>
      </ol>
    </div>
  </section>

  <%# ═════════════════════════════════════════════════════════════════════════
      THE TWO SIDES OF THE LIST — restaurants on the left, diners on the right,
      divided by a rule rather than boxed into cards.
      ═════════════════════════════════════════════════════════════════════════ %>
  <section class="spread py-14 md:py-20">
    <hr class="rule-heavy">

    <div class="mt-8 grid gap-12 md:mt-10 md:grid-cols-2 md:gap-0 md:divide-x md:divide-rule-fine">
      <article class="md:pr-10" aria-labelledby="restaurants-title">
        <p class="eyebrow"><%= t("landing.restaurants_label") %></p>
        <h2 id="restaurants-title" class="display-2 mt-5 text-h3 md:text-[2.25rem]"><%= t("landing.restaurants_title") %></h2>
        <p class="mt-4 text-pretty"><%= t("landing.restaurants_description") %></p>
        <p class="mt-4">
          <a class="link-mono" href="#">
            <%= t("landing.restaurants_cta") %>
            <%= icon "arrow-right", variant: "regular", class: "size-3.5 ml-2" %>
          </a>
        </p>
      </article>

      <article class="md:pl-10" aria-labelledby="customers-title">
        <p class="eyebrow"><%= t("landing.customers_label") %></p>
        <h2 id="customers-title" class="display-2 mt-5 text-h3 md:text-[2.25rem]"><%= t("landing.customers_title") %></h2>
        <p class="mt-4 text-pretty"><%= t("landing.customers_description") %></p>
        <p class="mt-4">
          <a class="link-mono" href="#">
            <%= t("landing.customers_cta") %>
            <%= icon "arrow-right", variant: "regular", class: "size-3.5 ml-2" %>
          </a>
        </p>
      </article>
    </div>
  </section>

  <%# ═════════════════════════════════════════════════════════════════════════
      CLOSING CALL — ruled top and bottom like a colophon
      ═════════════════════════════════════════════════════════════════════════ %>
  <section class="spread pb-16 md:pb-24" aria-labelledby="cta-title">
    <div class="cta-band">
      <h2 id="cta-title" class="display-2 press"><%= t("landing.cta_title") %></h2>
      <span class="leader leader-fine transform-none self-center" aria-hidden="true"></span>
      <a class="btn-wine shrink-0" href="#"><%= t("landing.cta_restaurant") %></a>
    </div>

    <p class="note measure mt-4"><%= t("landing.cta_subtitle") %></p>
  </section>
</main>

<%# ═══════════════════════════════════════════════════════════════════════════
    FOOTER — the running foot: wordmark, colophon line, locale switcher
    ═══════════════════════════════════════════════════════════════════════════ %>
<footer class="site-foot">
  <div class="site-foot-inner">
    <div>
      <a class="wordmark wordmark-paper" href="<%= root_path %>">aperto<b>.wine</b></a>
      <small class="mono-micro mt-2 block">&copy; <%= Date.current.year %> aperto.wine &middot; <%= t("landing.footer_rights") %></small>
    </div>

    <ul class="flex flex-wrap items-center gap-3">
      <%# The legal documents sit alongside the locale switcher rather than in a
          second row: the running foot is the one place on the site every reader
          knows to look for them. %>
      <li><%= link_to t("legal.nav.privacy"), privacy_path, class: "link-mono" %></li>
      <li><%= link_to t("legal.nav.terms"), terms_path, class: "link-mono" %></li>
      <% %i[en it].each do |locale| %>
        <li>
          <%= link_to locale.to_s.upcase, root_path(locale: locale), class: "link-mono", lang: locale,
                      aria: { current: ("true" if I18n.locale == locale) } %>
        </li>
      <% end %>
    </ul>
  </div>
</footer>
