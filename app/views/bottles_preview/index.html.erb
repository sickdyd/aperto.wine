<% content_for(:title) { "Bottle SVG Preview" } %>

<div class="min-h-screen max-w-6xl mx-auto px-4 py-8">
  <header class="text-center mb-10">
    <h1 class="font-display text-3xl font-light">Bottle SVG Preview</h1>
    <p class="text-sm text-base-content/50 mt-1">Temporary page for design iteration</p>
    <div class="divider-wine mt-6"></div>
  </header>

  <% @shapes.each do |shape| %>
    <section class="mb-16">
      <h2 class="font-display text-xl font-medium mb-6"><%= @shape_labels[shape] %></h2>

      <div class="flex flex-wrap gap-6 items-end">
        <%# Sealed bottle %>
        <div class="text-center">
          <%= render "shared/bottles/bottle",
            shape: shape,
            fill_percent: 100,
            sealed: true,
            wine_color: @wine_colors[shape],
            size: :md %>
          <p class="text-xs text-base-content/50 mt-2 font-body">Sealed</p>
        </div>

        <%# Open bottles at various fill levels %>
        <% @fill_levels.each do |fill| %>
          <div class="text-center">
            <%= render "shared/bottles/bottle",
              shape: shape,
              fill_percent: fill,
              sealed: false,
              wine_color: @wine_colors[shape],
              size: :md %>
            <p class="text-xs text-base-content/50 mt-2 font-body">Open · <%= fill %>%</p>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# Size comparison %>
  <section class="mb-16">
    <h2 class="font-display text-xl font-medium mb-6">Size Comparison</h2>
    <div class="flex flex-wrap gap-8 items-end">
      <% %i[sm md lg].each do |sz| %>
        <div class="text-center">
          <%= render "shared/bottles/bottle",
            shape: "bordeaux",
            fill_percent: 75,
            sealed: false,
            wine_color: "#722F37",
            size: sz %>
          <p class="text-xs text-base-content/50 mt-2 font-body"><%= sz %></p>
        </div>
      <% end %>
    </div>
  </section>

  <%# All wine colors side by side %>
  <section class="mb-16">
    <h2 class="font-display text-xl font-medium mb-6">Wine Colors</h2>
    <div class="flex flex-wrap gap-6 items-end">
      <% { "Red" => ["bordeaux", "#722F37"], "White" => ["burgundy", "#F5E6B8"], "Rose" => ["burgundy", "#E8A0A0"], "Sparkling" => ["champagne", "#F0DC82"], "Dessert" => ["flute", "#D4A840"] }.each do |label, (shape, color)| %>
        <div class="text-center">
          <%= render "shared/bottles/bottle",
            shape: shape,
            fill_percent: 75,
            sealed: false,
            wine_color: color,
            size: :md %>
          <p class="text-xs text-base-content/50 mt-2 font-body"><%= label %></p>
        </div>
      <% end %>
    </div>
  </section>
</div>
