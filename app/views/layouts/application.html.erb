<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="wine" class="scroll-smooth">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="aperto.wine">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for(:description) || t('landing.meta_description') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%# The ledger's three families: Instrument Serif for display, EB Garamond
        for body and menu copy, JetBrains Mono for labels, data and prices. %>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Instrument+Serif&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Disable CSS transitions/animations under system tests so Capybara never
        clicks an element mid-transition — a common source of flaky failures. %>
    <% if Rails.env.test? %>
      <style>
        *, *::before, *::after {
          transition-duration: 0s !important;
          transition-delay: 0s !important;
          animation-duration: 0s !important;
          animation-delay: 0s !important;
        }
      </style>
    <% end %>
  </head>

  <body class="bg-base-100 text-base-content font-body antialiased min-h-screen flex flex-col">
    <%# First focusable element in the document, before the flash and before
        anything a page yields, so one Tab from a fresh load always reaches it.
        Every template rendered through this layout carries <main id="main">;
        a skip link aimed at an id that is not there is worse than none. %>
    <a class="skip-link" href="#main"><%= t("shared.skip_to_content") %></a>

    <%# The flash stack is `position: fixed` and only in the document when
        there is something to say, so it is not a flex item of this body and
        costs the page below no space. %>
    <%= render "shared/flash" %>
    <%# flex-1: the centred auth pages size themselves off the remaining space
        rather than stacking their own min-h-screen wrapper and pushing the
        page past 100vh. Content pages (menu/cart/status) keep theirs. %>
    <div class="flex-1 flex flex-col">
      <%= yield %>
    </div>

    <%# The page's one grain overlay — paper fibre multiplied over everything,
        never interactive. Applied once here, never per-section. %>
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
