<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="wine" class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="aperto.wine">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for(:description) || t('landing.meta_description') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Disable CSS transitions/animations under system tests so Capybara never
        clicks an element mid-transition — a common source of flaky failures. %>
    <% if Rails.env.test? %>
      <style>
        *, *::before, *::after {
          transition-duration: 0s !important;
          transition-delay: 0s !important;
          animation-duration: 0s !important;
          animation-delay: 0s !important;
        }
      </style>
    <% end %>
  </head>

  <body class="bg-base-100 text-base-content font-body antialiased min-h-screen flex flex-col">
    <%= render "shared/flash" %>
    <%# flex-1: the centred auth pages size themselves off remaining space
        below the flash (see sessions/new, registrations/new) rather than
        their own min-h-screen stacking underneath it and pushing the page
        past 100vh. Content pages (menu/cart/status) keep their own
        min-h-screen wrapper unchanged — a little extra scroll from the
        flash above them was already fine, see Part E of the Task 5 brief. %>
    <div class="flex-1 flex flex-col">
      <%= yield %>
    </div>
  </body>
</html>
