<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="wine">
  <head>
    <title><%= content_for(:title) || t("app_name") %> — <%= t("owner.dashboard") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-100 text-base-content font-body antialiased min-h-screen">
    <div class="drawer lg:drawer-open">
      <input id="owner-drawer" type="checkbox" class="drawer-toggle">

      <div class="drawer-content flex min-h-screen flex-col">
        <%# Mobile top bar %>
        <header class="navbar sticky top-0 z-40 bg-base-100 border-b border-base-content/5 lg:hidden">
          <label for="owner-drawer" class="btn btn-square btn-ghost drawer-button" aria-label="<%= t("owner.nav.open_menu") %>">
            <%= icon "list", css: "size-5" %>
          </label>
          <a href="<%= owner_restaurants_path %>" class="font-display text-lg font-semibold text-primary px-2">aperto.wine</a>
        </header>

        <%# Flash messages %>
        <% if notice %>
          <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div role="alert" class="alert alert-success text-sm">
              <%= icon "check-circle", css: "size-4" %>
              <span><%= notice %></span>
            </div>
          </div>
        <% end %>
        <% if alert %>
          <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div role="alert" class="alert alert-error text-sm">
              <%= icon "warning", css: "size-4" %>
              <span><%= alert %></span>
            </div>
          </div>
        <% end %>

        <%# Main content %>
        <main class="w-full max-w-6xl mx-auto flex-1 px-4 sm:px-6 lg:px-8 py-8">
          <%= yield %>
        </main>
      </div>

      <div class="drawer-side z-50">
        <label for="owner-drawer" aria-label="<%= t("owner.nav.close_menu") %>" class="drawer-overlay"></label>
        <%= render "owner/shared/sidebar" %>
      </div>
    </div>
  </body>
</html>
