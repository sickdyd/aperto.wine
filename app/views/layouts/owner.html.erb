<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="wine">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || t("app_name") %> — <%= t("owner.dashboard") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%# Same three families as the public shell — the admin uses the display
        face sparingly (see `.ledger-admin` in the stylesheet), not never. %>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Instrument+Serif&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Disable CSS transitions/animations under system tests so Capybara never
        clicks an element mid-transition — a common source of flaky failures.
        The admin drawer slides, so without this the owner suite is markedly
        flakier than the public one, which has had this guard all along. %>
    <% if Rails.env.test? %>
      <style>
        *, *::before, *::after {
          transition-duration: 0s !important;
          transition-delay: 0s !important;
          animation-duration: 0s !important;
          animation-delay: 0s !important;
        }
      </style>
    <% end %>
  </head>

  <%# ledger-admin: the same tokens and vocabulary as the public shell, held
      quiet — compressed type scale, no display face in headings, denser
      controls, softened grain. The admin should disappear into the task. %>
  <body class="ledger-admin bg-base-100 text-base-content font-body antialiased min-h-screen">
    <%# The order-sound controller is mounted on the shell rather than on
        either toggle: there are two toggles, they live in different corners of
        the page (drawer and top bar), and they are two views of one preference
        that must never disagree. It is also where the poller's arrival event
        is caught — the poller sits inside this element, so the event reaches
        here on its way to the window. %>
    <div class="drawer lg:drawer-open"
         data-controller="order-sound"
         data-action="order-notifications:new-orders@window->order-sound#announce">
      <input id="owner-drawer" type="checkbox" class="drawer-toggle">

      <div class="drawer-content flex min-h-screen flex-col">
        <%# Mobile top bar %>
        <header class="navbar sticky top-0 z-40 bg-base-100 border-b border-base-content/5 lg:hidden">
          <label for="owner-drawer" class="btn btn-square btn-ghost drawer-button" aria-label="<%= t("owner.nav.open_menu") %>">
            <%= icon "list", class: "size-5" %>
          </label>
          <a href="<%= owner_restaurants_path %>" class="font-display text-lg font-semibold text-primary px-2">aperto.wine</a>

          <%# The sidebar's orders entry is behind the drawer on a phone, and a
              tally nobody can see without opening a drawer is not a tally. The
              same badge, on the one piece of chrome a phone always shows. %>
          <% if @restaurant&.persisted? %>
            <%# Icon only here — the top bar has no room for a word, so each
                face carries its label to the accessibility tree instead. %>
            <%= render "owner/shared/sound_toggle",
                       id: Owner::OrdersHelper::SOUND_TOGGLE_IDS[:mobile],
                       class_name: "nav-item sound-toggle ml-auto px-3",
                       label_class: "sr-only" %>
            <%= link_to owner_restaurant_orders_path(@restaurant),
                  class: "nav-item px-3",
                  aria: { label: t("owner.restaurants.orders") } do %>
              <%= icon "receipt", class: "size-4 shrink-0" %>
              <%= render "owner/orders/badge",
                         id: Owner::OrdersHelper::BADGE_IDS[:mobile],
                         count: owner_pending_orders_count(@restaurant) %>
            <% end %>
          <% end %>
        </header>

        <%# Flash messages, and the stack that arriving orders are announced in %>
        <%= render "owner/shared/flash" %>

        <%# The live order poller. Mounted per restaurant, because that is what
            it asks about — outside a restaurant (the restaurant index, a new
            restaurant form) there is nothing to announce, and no element here
            means no polling at all rather than a request that answers nothing.
            It seeds itself with the orders already on the page so the first
            poll after every navigation announces none of them again. %>
        <% if @restaurant&.persisted? %>
          <div hidden
               data-controller="order-notifications"
               data-order-notifications-url-value="<%= notifications_owner_restaurant_orders_path(@restaurant) %>"
               data-order-notifications-badge-id-value="<%= Owner::OrdersHelper::BADGE_IDS[:sidebar] %>"
               data-order-notifications-known-value="<%= owner_recent_order_ids(@restaurant).to_json %>"
               data-order-notifications-interval-value="<%= order_notifications_poll_interval_ms %>"></div>
        <% end %>

        <%# Main content %>
        <main class="w-full max-w-6xl mx-auto flex-1 px-4 sm:px-6 lg:px-8 py-8">
          <%= yield %>
        </main>
      </div>

      <div class="drawer-side z-50">
        <label for="owner-drawer" aria-label="<%= t("owner.nav.close_menu") %>" class="drawer-overlay"></label>
        <%= render "owner/shared/sidebar" %>
      </div>
    </div>

    <%# The page's one grain overlay, halved in the admin (see --grain-opacity). %>
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
