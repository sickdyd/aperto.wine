<% content_for(:title) { t("auth.sign_in") } %>

<div class="min-h-screen flex items-center justify-center px-6">
  <div class="w-full max-w-sm">
    <div class="text-center mb-10">
      <a href="<%= root_path %>" class="font-display text-2xl font-semibold text-primary">aperto.wine</a>
      <h1 class="font-display text-3xl font-light mt-4"><%= t("auth.sign_in") %></h1>
    </div>

    <% if flash[:alert] %>
      <div role="alert" class="alert alert-error mb-6 text-sm">
        <%= icon "warning", css: "size-4" %>
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <%= form_with url: sign_in_path, method: :post, class: "space-y-5" do |f| %>
      <div class="form-control">
        <%= f.label :email, t("auth.email"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.email_field :email, value: params[:email], required: true, autofocus: true, autocomplete: "email", class: "input input-bordered w-full font-body", placeholder: "you@example.com" %>
      </div>

      <div class="form-control">
        <%= f.label :password, t("auth.password"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password", class: "input input-bordered w-full font-body" %>
      </div>

      <%= f.submit t("auth.sign_in"), class: "btn-wine w-full btn-md mt-2" %>
    <% end %>

    <p class="text-center mt-8 text-sm text-base-content/50">
      <%= t("auth.no_account") %>
      <a href="<%= sign_up_path %>" class="text-primary hover:underline"><%= t("auth.sign_up_link") %></a>
    </p>
  </div>
</div>
