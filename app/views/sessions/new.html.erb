<% content_for(:title) { t("auth.sign_in") } %>

<div class="min-h-screen flex items-center justify-center px-6">
  <div class="w-full max-w-sm">
    <div class="text-center mb-10">
      <a href="<%= root_path %>" class="font-display text-2xl font-semibold text-primary">aperto.wine</a>
      <h1 class="font-display text-3xl font-light mt-4"><%= t("auth.sign_in") %></h1>
    </div>

    <% if flash[:alert] %>
      <div role="alert" class="alert alert-error mb-6 text-sm">
        <%= icon "warning", css: "size-4" %>
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <div data-controller="dev-login">
      <%= form_with url: sign_in_path, method: :post, class: "space-y-5" do |f| %>
        <div class="field">
          <%= f.label :email, t("auth.email"), class: "field-label" %>
          <%= f.email_field :email, value: params[:email], required: true, autofocus: true, autocomplete: "email", class: "input w-full font-body", placeholder: "you@example.com", data: { dev_login_target: "email" } %>
        </div>

        <div class="field">
          <%= f.label :password, t("auth.password"), class: "field-label" %>
          <%= f.password_field :password, required: true, autocomplete: "current-password", class: "input w-full font-body", data: { dev_login_target: "password" } %>
        </div>

        <%= f.submit t("auth.sign_in"), class: "btn-wine w-full btn-md mt-2" %>
      <% end %>

      <%# Opt-in on deployed environments (staging sets SHOW_DEV_LOGIN=1; the
          production block in render.yaml deliberately does not). The buttons
          only pre-fill the form — the password is still verified on submit. %>
      <% if Rails.env.development? || ENV["SHOW_DEV_LOGIN"] == "1" %>
        <div class="mt-8 pt-6 border-t border-base-content/10">
          <p class="text-center text-xs uppercase tracking-wider text-base-content/40 mb-3">Dev quick login</p>
          <div class="flex flex-wrap justify-center gap-2">
            <% [
              { label: "Admin", email: "admin@aperto.wine" },
              { label: "Owner", email: "owner@aperto.wine" },
              { label: "Customer", email: "customer@aperto.wine" }
            ].each do |account| %>
              <button type="button"
                      class="btn btn-outline btn-sm font-body"
                      data-action="dev-login#fill"
                      data-dev-login-email-param="<%= account[:email] %>"
                      data-dev-login-password-param="password">
                <%= account[:label] %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <p class="text-center mt-8 text-sm text-base-content/50">
      <%= t("auth.no_account") %>
      <a href="<%= sign_up_path %>" class="text-primary hover:underline"><%= t("auth.sign_up_link") %></a>
    </p>
  </div>
</div>
