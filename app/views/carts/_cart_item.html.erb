<%#
  Renders a single cart line as a row of the bill: colour dot, wine, a leader
  running to the line's money, the pour and unit price hanging underneath,
  and the two controls that change it.

  The row is an <li> inside the .group-body list on carts/show — that is
  where its padding and the hairline under it come from.

  Locals:
    item       - the CartItem to render (required)
    restaurant - the owning Restaurant, for building the item routes (required)
    over_stock - true when this wine's total across the whole cart outruns its
                 remaining glasses (required; see Cart#over_stock_wine_ids).
                 A fact about the wine, not about this row: the same wine at
                 two glass sizes draws on one pool, so both rows come in
                 flagged and both name the wine's remaining total.
%>
<% field_id = "cart_item_#{item.wine.id}_#{item.glass_size_ml}" %>
<% meta = [ item.wine.producer, item.wine.vintage_year ].compact_blank.join(" · ") %>
<% quantity_attributes = { id: "#{field_id}_quantity", class: "select num w-20 min-h-11" } %>
<% if over_stock %>
  <% quantity_attributes = quantity_attributes.merge("aria-invalid": "true", "aria-describedby": "#{field_id}_stock") %>
<% end %>
<li>
  <p class="leader-row">
    <%= wine_color_dot(item.wine.color, label: false) %>
    <span class="wine-name leader-label"><%= item.wine.name %></span>
    <span class="leader" aria-hidden="true"></span>
    <span class="leader-value">
      <span class="sr-only"><%= t("cart.subtotal_label") %></span>
      <%= format_cents(item.subtotal_cents) %>
    </span>
  </p>

  <% if meta.present? %>
    <p class="wine-meta"><%= meta %></p>
  <% end %>

  <%# Pour and unit price: the two figures the subtotal above is derived
      from, set as ledger data rather than as three labelled columns. %>
  <p class="price-size mt-2 flex flex-wrap items-baseline gap-x-4 gap-y-1 pl-[var(--indent)]">
    <span>
      <%= t("cart.glass_size_label") %>
      <span class="num text-ox-3"><%= item.glass_size_ml %> ml</span>
    </span>
    <span>
      <%= t("cart.unit_price_label") %>
      <span class="num text-ox-3"><%= format_cents(item.unit_price_cents) %></span>
    </span>
  </p>

  <%# The shortfall, written as an annotation in oxblood rather than as a
      second alert band: the line is still a line of the bill, so it keeps the
      ledger's own voice and its controls. It is announced with the quantity
      select (aria-describedby below) because that select is the fix. %>
  <% if over_stock %>
    <p id="<%= field_id %>_stock" class="note text-ox-2 mt-2 pl-[var(--indent)]">
      <%= t("cart.stock_shortfall", count: item.wine.available_glasses) %>
    </p>
  <% end %>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-3 pl-[var(--indent)]">
    <%= form_with url: cart_items_path(restaurant_slug: restaurant.slug), method: :patch, class: "flex items-center gap-3" do |f| %>
      <%= f.hidden_field :wine_id, value: item.wine.id %>
      <%= f.hidden_field :glass_size_ml, value: item.glass_size_ml %>
      <%# The quantity control's accessible name has to name the wine: with
          several lines on the page, "Quantity" alone would leave every
          select indistinguishable to a screen-reader user. %>
      <label class="sr-only" for="<%= field_id %>_quantity">
        <%= t("cart.quantity_label", wine: item.wine.name) %>
      </label>
      <%# aria-invalid, not just a description: the value in the select is the
          thing that is wrong, and the note above is why (the same pairing
          FormErrorsHelper#field_error_attributes makes for owner forms). %>
      <%= f.select :quantity, 1..Cart::MAX_QUANTITY_PER_ITEM, { selected: item.quantity },
            quantity_attributes %>
      <button type="submit" class="btn-wine-outline"><%= t("cart.update_quantity") %></button>
    <% end %>

    <%# Icon-only, so the accessible name is the aria-label alone — and it
        names the wine for the same reason the quantity label does. `px-4`
        narrows the block enough that the whole control row still fits on one
        line at 390px; the 46px minimum height keeps the target legal. %>
    <%= button_to cart_items_path(restaurant_slug: restaurant.slug), method: :delete,
          params: { wine_id: item.wine.id, glass_size_ml: item.glass_size_ml },
          class: "btn-wine-quiet shrink-0 px-4",
          "aria-label": t("cart.remove_item", wine: item.wine.name) do %>
      <%= icon "trash", class: "size-4" %>
    <% end %>
  </div>
</li>
