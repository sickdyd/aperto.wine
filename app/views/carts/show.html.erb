<% content_for(:title) { "#{@restaurant.name} — #{t('cart.title')}" } %>

<%# The cart is the itemised bill, printed on the sheet the menu was printed
    on (see menus/show) so the walk from list to order never changes stock:
    one ruled line per pour, a leader running from each wine to its money,
    and a heavy rule closing the column off from the total. Wider than the
    menu card — the bill carries controls the list does not. %>
<main class="band-stock flex-1">
  <div class="sheet mx-auto w-full max-w-2xl">
    <%# Letterhead — where you are, what this page is, and which table it
        will reach. %>
    <header>
      <a href="<%= menu_path(id: @restaurant) %>" class="link-mono gap-2">
        <%= icon "arrow-left", class: "size-3.5" %>
        <%= t("cart.back_to_menu") %>
      </a>

      <p class="mono-label mt-3 text-ox-3"><%= @restaurant.name %></p>
      <h1 class="display-2 mt-1"><%= t("cart.title") %></h1>

      <% if @table %>
        <%# The page's one ink stamp — the table this bill belongs to. %>
        <p class="mt-5"><span class="stamp"><%= t("cart.table_context", table: @table.name) %></span></p>
      <% else %>
        <p class="note mt-4"><%= t("cart.no_table_context") %></p>
      <% end %>
    </header>

    <hr class="rule-section mt-6 mb-8">

    <%# @cart.items/#dropped_items are loaded together from one query (see
        Cart#load_cart_data) — read each once so the rest of this page never
        re-triggers it. %>
    <% dropped_items = @cart.dropped_items %>
    <% items = @cart.items %>

    <% if dropped_items.any? %>
      <div role="alert" class="alert alert-warning flex items-start gap-3 mb-6">
        <%= icon "warning", class: "size-4 shrink-0 mt-1" %>
        <span class="min-w-0"><%= t("cart.dropped_items_notice") %></span>
      </div>

      <ul class="space-y-3 mb-8">
        <% dropped_items.each do |dropped| %>
          <%= render "dropped_cart_item", dropped: dropped, restaurant: @restaurant %>
        <% end %>
      </ul>
    <% end %>

    <%# Distinct from @cart.empty? (which only counts orderable items): a
        cart can hold nothing but a dropped line, and the diner must still be
        able to clear it — see Cart#any_lines?. %>
    <% if @cart.any_lines? %>
      <% if items.any? %>
        <ul class="group-body">
          <% items.each do |item| %>
            <%= render "cart_item", item: item, restaurant: @restaurant %>
          <% end %>
        </ul>

        <%# The heavy rule closes the itemised column; the total is the last
            leader on the page and the only figure set at heading size. %>
        <hr class="rule-heavy">
        <div class="leader-row pt-4">
          <span class="mono-label text-ox-2"><%= t("cart.total") %></span>
          <span class="leader leader-fine" aria-hidden="true"></span>
          <span class="leader-value text-h3"><%= format_cents(@cart.total_cents) %></span>
        </div>
      <% end %>

      <div class="mt-3 flex justify-end">
        <%= button_to t("cart.clear_cart"), cart_path(restaurant_id: @restaurant), method: :delete,
              class: "btn-wine-quiet",
              data: { turbo_confirm: t("cart.confirm_clear") } %>
      </div>

      <% if items.any? %>
        <hr class="rule-section mt-6">

        <%= form_with url: orders_path(restaurant_id: @restaurant), method: :post, class: "form-section mt-8" do |f| %>
          <div class="field">
            <%= f.label :guest_name, t("orders.form.guest_name"), class: "field-label" %>
            <%= f.text_field :guest_name, maxlength: 64, placeholder: t("orders.form.guest_name_placeholder"),
                  class: "input w-full min-h-11" %>
          </div>

          <%# Honeypot: a real text input a scripted bot will happily fill, but
              genuinely inert for a human — hidden visually, out of tab order,
              and invisible to assistive technology, not merely type="hidden"
              (which many bots already know to skip). Named away from anything
              browser autofill or a password manager targets (not website,
              email, name, phone, address, url, company) — those get filled by
              well-meaning autofill even with autocomplete="off", which is
              advisory and routinely ignored. A screen-reader or keyboard user
              must never be asked to fill it. %>
          <div class="hidden" aria-hidden="true">
            <%= f.text_field :contact_reference, tabindex: -1, autocomplete: "off" %>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-wine w-full"><%= t("orders.form.submit") %></button>
          </div>
        <% end %>
      <% else %>
        <%# Only dropped lines remain — nothing left to order until the diner
            removes them (above) or clears the cart. %>
        <div class="empty-state">
          <p><%= t("cart.empty") %></p>
          <a href="<%= menu_path(id: @restaurant) %>" class="btn-wine mt-6 not-italic"><%= t("cart.browse_menu") %></a>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state py-14">
        <p><%= t("cart.empty") %></p>
        <a href="<%= menu_path(id: @restaurant) %>" class="btn-wine mt-6 not-italic"><%= t("cart.browse_menu") %></a>
      </div>
    <% end %>
  </div>
</main>
