<% content_for(:title) { "#{@restaurant.name} — #{t('owner.qr_code.title')}" } %>

<div class="admin-head print:hidden">
  <div>
    <h1 class="admin-title"><%= t("owner.qr_code.title") %></h1>
    <p class="admin-subtitle mt-1"><%= @restaurant.name %></p>
  </div>

  <button type="button" onclick="window.print()" class="btn-wine">
    <%= icon "printer", css: "size-4" %>
    <%= t("owner.qr_code.print") %>
  </button>
</div>

<div class="grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] print:block">
  <%# The card as it will be printed. %>
  <div>
    <%= render "owner/restaurant_tables/qr_card",
               restaurant: @restaurant,
               qr_svg: @qr_svg,
               id: "qr-code",
               extra_class: "sheet-narrow qr-card-single" %>
  </div>

  <div class="space-y-8 print:hidden">
    <p class="note measure"><%= t("owner.qr_code.description") %></p>

    <div class="field">
      <label class="field-label" for="menu-url"><%= t("owner.qr_code.menu_link") %></label>
      <div class="flex items-end gap-2">
        <input type="text" value="<%= @menu_url %>" readonly class="input w-full font-body" id="menu-url">
        <button type="button"
                onclick="navigator.clipboard.writeText(document.getElementById('menu-url').value)"
                class="btn-wine-quiet"
                aria-label="<%= t("owner.qr_code.copy_link") %>">
          <%= icon "copy", css: "size-4" %>
        </button>
      </div>
    </div>

    <section>
      <h2 class="form-section-title"><%= t("owner.qr_code.instructions_title") %></h2>
      <%# Ruled rows with hanging mono numerals — a ledger, not a bullet list. %>
      <ol class="mt-3">
        <% t("owner.qr_code.instructions").each_with_index do |step, i| %>
          <li class="flex gap-4 border-b border-rule-hair py-3">
            <span class="mono-label num shrink-0 text-ox-3"><%= format("%02d", i + 1) %></span>
            <span class="text-ink-soft"><%= step %></span>
          </li>
        <% end %>
      </ol>
    </section>
  </div>
</div>

<%= render "owner/restaurant_tables/print_styles" %>
