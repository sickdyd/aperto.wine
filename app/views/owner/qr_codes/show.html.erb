<% content_for(:title) { "#{@restaurant.name} — #{t('owner.qr_code.title')}" } %>

<div class="mb-8">
  <a href="<%= owner_restaurant_path(@restaurant) %>" class="text-sm text-base-content/50 hover:text-primary flex items-center gap-1 mb-4">
    <%= icon "arrow-left", css: "size-3.5" %>
    <%= @restaurant.name %>
  </a>
  <h1 class="font-display text-3xl font-light"><%= t("owner.qr_code.title") %></h1>
  <p class="text-base-content/50 mt-2"><%= t("owner.qr_code.description") %></p>
</div>

<div class="grid md:grid-cols-2 gap-12">
  <%# QR Code display %>
  <div class="flex flex-col items-center">
    <div id="qr-code" class="bg-white p-8 rounded-xl border border-base-content/10 shadow-sm text-base-content">
      <div class="w-64 h-64 flex items-center justify-center">
        <%= @qr_svg.html_safe %>
      </div>
      <p class="text-center mt-4 font-display text-lg font-medium"><%= @restaurant.name %></p>
      <p class="text-center text-xs text-base-content/40 mt-1">aperto.wine</p>
    </div>

    <button onclick="window.print()" class="btn-wine btn-sm mt-6">
      <%= icon "printer", css: "size-4" %>
      <%= t("owner.qr_code.print") %>
    </button>
  </div>

  <%# Link and instructions %>
  <div class="space-y-6">
    <div>
      <h3 class="font-body text-xs uppercase tracking-[0.15em] text-base-content/50 mb-2"><%= t("owner.qr_code.menu_link") %></h3>
      <div class="flex items-center gap-2">
        <input type="text" value="<%= @menu_url %>" readonly class="input input-bordered w-full font-body text-sm" id="menu-url">
        <button onclick="navigator.clipboard.writeText(document.getElementById('menu-url').value)" class="btn btn-ghost btn-sm">
          <%= icon "copy", css: "size-4" %>
        </button>
      </div>
    </div>

    <div class="divider"></div>

    <div>
      <h3 class="font-body text-xs uppercase tracking-[0.15em] text-base-content/50 mb-3"><%= t("owner.qr_code.instructions_title") %></h3>
      <ol class="space-y-3 text-sm text-base-content/70">
        <% t("owner.qr_code.instructions").each_with_index do |step, i| %>
          <li class="flex gap-3">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 text-primary text-xs flex items-center justify-center font-medium"><%= i + 1 %></span>
            <span><%= step %></span>
          </li>
        <% end %>
      </ol>
    </div>
  </div>
</div>

<%# Print styles %>
<style media="print">
  nav, .btn, button, input, .divider, ol, h3 { display: none !important; }
  #qr-code { border: none !important; box-shadow: none !important; margin: auto; }
</style>
