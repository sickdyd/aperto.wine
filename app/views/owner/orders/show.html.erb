<% content_for(:title) { "#{t('owner.orders.order')} ##{@order.id}" } %>

<%# The docket. Read top to bottom: who and where, then the lines with their
    leaders, then a heavy rule and the total. Every figure mono and tabular. %>
<% status_icons = { "pending" => "hourglass", "approved" => "check-circle", "cancelled" => "x-circle", "completed" => "checks" } %>

<%= link_to owner_restaurant_orders_path(@restaurant), class: "link-mono -mt-2 mb-1 justify-start gap-2" do %>
  <%= icon "arrow-left", class: "size-4 shrink-0" %>
  <%= t("owner.orders.title") %>
<% end %>

<div class="admin-head">
  <div>
    <h1 class="admin-title"><%= t("owner.orders.order") %> #<%= @order.id %></h1>
    <p class="admin-subtitle">
      <time datetime="<%= @order.created_at.iso8601 %>" title="<%= l(@order.created_at, format: :long) %>">
        <%= t("owner.orders.time_ago", time: time_ago_in_words(@order.created_at)) %>
      </time>
    </p>
  </div>
  <%# Never colour alone: the icon and the word carry the state too. %>
  <span class="badge gap-1.5 <%= "badge-outline" unless @order.pending? %> <%= order_status_badge_class(@order.status) %>">
    <%= icon status_icons[@order.status], class: "size-3.5 shrink-0" %>
    <%= t("owner.orders.statuses.#{@order.status}") %>
  </span>
</div>

<div class="max-w-xl">
  <%# The table is what staff carry the docket to — the one stamp on the page. %>
  <div class="mb-6 flex flex-wrap items-center gap-x-6 gap-y-3">
    <p class="stamp">
      <%= icon "picnic-table", class: "size-4 shrink-0" %>
      <% if @order.restaurant_table %>
        <%# Name first, as on the board — the number is what staff scan for. %>
        <%= [ @order.restaurant_table.name, @order.restaurant_table.area ].compact_blank.join(" · ") %>
      <% else %>
        <%= t("owner.orders.no_table") %>
      <% end %>
    </p>
    <p class="text-meta text-ink-soft">
      <span class="mono-micro"><%= t("owner.orders.customer") %></span>
      <%= order_customer_label(@order) %>
    </p>
  </div>

  <div class="list-head">
    <h2 class="list-title"><%= t("owner.orders.items") %></h2>
    <span class="leader" aria-hidden="true"></span>
    <span class="mono-micro"><%= t("owner.orders.subtotal") %></span>
  </div>

  <ul>
    <% @order.order_items.includes(:wine).each do |item| %>
      <li class="border-b border-rule-hair py-3 last:border-b-0">
        <div class="leader-row">
          <span class="leader-label">
            <span class="font-mono text-ox-3 num"><%= item.quantity %>&times;</span>
            <%= item.wine.name %>
          </span>
          <span class="leader" aria-hidden="true"></span>
          <span class="leader-value"><%= format_cents(item.subtotal_cents) || "—" %></span>
        </div>
        <p class="mono-micro mt-1 pl-6">
          <%= item.glass_size_ml %>ml · <%= format_cents(item.unit_price_cents) || "—" %> ×<%= item.quantity %>
        </p>
      </li>
    <% end %>
  </ul>

  <hr class="rule-heavy mt-4">

  <div class="leader-row pt-3">
    <span class="leader-label mono-label text-ox-2"><%= t("owner.orders.total") %></span>
    <span class="leader" aria-hidden="true"></span>
    <span class="leader-value text-h4"><%= format_cents(@order.total_amount_cents) || "—" %></span>
  </div>

  <% if @order.pending? %>
    <div class="form-actions mt-8">
      <%= button_to approve_owner_restaurant_order_path(@restaurant, @order), method: :patch, class: "btn-wine min-h-11" do %>
        <%= icon "check", class: "size-4" %>
        <%= t("owner.orders.approve") %>
      <% end %>
      <%= button_to cancel_owner_restaurant_order_path(@restaurant, @order),
            method: :patch,
            class: "btn-wine-quiet min-h-11",
            data: { turbo_confirm: t("owner.orders.confirm_cancel") } do %>
        <%= icon "x", class: "size-4" %>
        <%= t("owner.orders.cancel_order") %>
      <% end %>
    </div>
  <% end %>
</div>
