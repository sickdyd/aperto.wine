<%# The owner flash. #flash-messages must exist on every render, empty or not —
    owner/wine_list_items replaces it by id from a Turbo Stream, and a missing
    target is a silently dropped message. It is the Turbo target and nothing
    else: no styling, no fixed positioning of its own, so when there is no
    flash it is an empty div that occupies no height.

    The band inside it is the same one the public shell renders, floating in
    the same `.toast-stack` — see shared/_flash_band. %>
<div id="flash-messages">
  <% if notice || alert %>
    <div class="toast-stack">
      <% if notice %>
        <%= render "shared/flash_band",
                   variant: "alert-success",
                   icon_name: "check-circle",
                   label: t("shared.flash_notice"),
                   message: notice %>
      <% end %>
      <% if alert %>
        <%= render "shared/flash_band",
                   variant: "alert-error",
                   icon_name: "warning",
                   label: t("shared.flash_error"),
                   message: alert %>
      <% end %>
    </div>
  <% end %>
</div>
