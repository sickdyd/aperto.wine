<%# The owner admin's index column: the public shell's vocabulary held quiet.
    Mono caps entries, hairlines between groups, one heavy rule under the
    masthead, no display type, no illustration, no shadow. Restaurant and
    user names keep the text face and their own casing — they are content,
    not chrome, and are never shouted in caps.

    Both link families go through `owner_nav_link_attrs`, which supplies the
    `menu-active` marker and `aria-current="page"`. `.nav-item` turns that
    aria-current into the left rule that marks the current section, so the
    highlight and the assistive-tech state are the same fact. %>
<%
  # daisyUI's `.menu-active` is a global rule in the utilities layer, so it
  # outranks both `.nav-item[aria-current]` and the base focus ring: it blanks
  # the colour (its --menu-active-fg is only defined inside a .menu) and sets
  # outline-style: none. The helper still emits the class — the system tests
  # select on it — so the current entry restates its ink, and every entry
  # restates the base focus ring, as utilities, which land later in that layer.
  focus_ring = "focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-ox-2 focus-visible:outline-offset-[3px]"
  current_ink = "text-ox-1"

  nav_link_attrs = lambda do |active|
    attrs = owner_nav_link_attrs(active)
    attrs.merge(class: ["nav-item px-4", focus_ring, attrs[:class], (current_ink if active)])
  end

  # Switcher rows borrow .nav-item's target size, hover and current state but
  # set the label back in the body face, mixed case: these are proper names.
  switcher_link_attrs = lambda do |active|
    attrs = owner_nav_link_attrs(active)
    attrs.merge(class: ["nav-item px-4 font-body text-meta normal-case tracking-normal", focus_ring, attrs[:class], (current_ink if active)])
  end
%>
<%# h-full as well as min-h-full: the drawer gives the column a definite
    height, which is what lets the nav region below scroll on its own and
    keeps the masthead and the sign-out foot in place when the switcher is
    open on a short window. %>
<aside class="flex h-full min-h-full w-64 flex-col border-r border-rule-fine bg-paper">
  <%# Masthead: wordmark over its running head, closed by the section rule. %>
  <div class="px-4 pt-3 pb-2">
    <a href="<%= owner_restaurants_path %>" class="wordmark wordmark-paper">aperto.wine</a>
    <p class="mono-micro"><%= t("owner.dashboard") %></p>
  </div>
  <hr class="rule-heavy">

  <div class="flex-1 overflow-y-auto">
    <%# Restaurant context switcher — a native <details> that opens in place,
        rather than a floating panel the ledger has no shadow to lift. %>
    <% if @sidebar_restaurants.any? %>
      <div class="px-4 pt-3 pb-1">
        <details>
          <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 border-b border-rule-medium [&::-webkit-details-marker]:hidden">
            <%= icon "storefront", class: "size-4 shrink-0 text-ox-3" %>
            <span class="min-w-0 flex-1 truncate text-meta text-ink"><%= @restaurant&.persisted? ? @restaurant.name : t("owner.nav.select_restaurant") %></span>
            <%= icon "caret-up-down", class: "size-4 shrink-0 text-ox-3" %>
          </summary>

          <ul class="-mx-4 mt-1">
            <% @sidebar_restaurants.each do |restaurant| %>
              <li>
                <%= link_to owner_restaurant_path(restaurant), **switcher_link_attrs.call(@restaurant&.persisted? && @restaurant == restaurant) do %>
                  <span class="truncate"><%= restaurant.name %></span>
                <% end %>
              </li>
            <% end %>
            <li>
              <hr class="rule-hair my-1">
            </li>
            <li>
              <%= link_to owner_restaurants_path, class: "nav-item px-4 #{focus_ring}" do %>
                <%= icon "squares-four", class: "size-4 shrink-0" %>
                <%= t("owner.nav.all_restaurants") %>
              <% end %>
            </li>
            <li>
              <%= link_to new_owner_restaurant_path, class: "nav-item px-4 #{focus_ring}" do %>
                <%= icon "plus", class: "size-4 shrink-0" %>
                <%= t("owner.nav.new_restaurant") %>
              <% end %>
            </li>
          </ul>
        </details>
      </div>
    <% end %>

    <%# Section navigation, ruled into three groups: the list, the floor,
        and the settings that sit behind both. %>
    <nav class="py-2" aria-label="<%= t("owner.dashboard") %>">
      <% if @restaurant&.persisted? %>
        <ul>
          <li>
            <%= link_to owner_restaurant_path(@restaurant), **nav_link_attrs.call(owner_nav_active?("restaurants", actions: "show")) do %>
              <%= icon "house", class: "size-4 shrink-0" %>
              <%= t("owner.nav.overview") %>
            <% end %>
          </li>
          <li>
            <%= link_to owner_restaurant_wines_path(@restaurant), **nav_link_attrs.call(owner_nav_active?("wines")) do %>
              <%= icon "wine", class: "size-4 shrink-0" %>
              <%= t("owner.nav.wines") %>
            <% end %>
          </li>
          <li>
            <%= link_to owner_restaurant_wine_lists_path(@restaurant), **nav_link_attrs.call(owner_nav_active?(%w[wine_lists wine_list_items])) do %>
              <%= icon "scroll", class: "size-4 shrink-0" %>
              <%= t("owner.restaurants.wine_lists") %>
            <% end %>
          </li>
        </ul>

        <hr class="rule-hair my-2">

        <ul>
          <li>
            <%= link_to owner_restaurant_orders_path(@restaurant), **nav_link_attrs.call(owner_nav_active?("orders")) do %>
              <%= icon "receipt", class: "size-4 shrink-0" %>
              <%= t("owner.restaurants.orders") %>
            <% end %>
          </li>
          <li>
            <%= link_to owner_restaurant_tables_path(@restaurant), **nav_link_attrs.call(owner_nav_active?("restaurant_tables")) do %>
              <%= icon "picnic-table", class: "size-4 shrink-0" %>
              <%= t("owner.restaurants.tables") %>
            <% end %>
          </li>
          <li>
            <%= link_to owner_restaurant_qr_code_path(@restaurant), **nav_link_attrs.call(owner_nav_active?("qr_codes")) do %>
              <%= icon "qr-code", class: "size-4 shrink-0" %>
              <%= t("owner.restaurants.qr_code") %>
            <% end %>
          </li>
        </ul>

        <hr class="rule-hair my-2">

        <ul>
          <li>
            <%= link_to edit_owner_restaurant_path(@restaurant), **nav_link_attrs.call(owner_nav_active?("restaurants", actions: %w[edit update])) do %>
              <%= icon "gear", class: "size-4 shrink-0" %>
              <%= t("owner.nav.settings") %>
            <% end %>
          </li>
        </ul>
      <% else %>
        <ul>
          <li>
            <%= link_to owner_restaurants_path, **nav_link_attrs.call(owner_nav_active?("restaurants", actions: "index")) do %>
              <%= icon "squares-four", class: "size-4 shrink-0" %>
              <%= t("owner.restaurants.title") %>
            <% end %>
          </li>
        </ul>
      <% end %>
    </nav>
  </div>

  <%# The running foot: who is signed in, and the way out. %>
  <div class="border-t border-rule-fine px-4 py-3">
    <p class="truncate text-meta text-ink-soft" title="<%= current_user.name %>"><%= current_user.name %></p>
    <%= button_to t("auth.sign_out"), sign_out_path, method: :delete, class: "btn-wine-quiet mt-2 min-h-11 w-full" %>
  </div>
</aside>
