<%= form_with model: [:owner, restaurant], class: "space-y-8 max-w-xl" do |f| %>
  <% if restaurant.errors.any? %>
    <div role="alert" class="alert alert-error items-start">
      <%= icon "warning", class: "size-4 shrink-0 translate-y-0.5" %>
      <div>
        <% restaurant.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <fieldset class="form-section">
    <legend class="form-section-title mb-4"><%= t("owner.restaurants.form.section_details") %></legend>

    <div class="field">
      <%= f.label :name, t("owner.restaurants.form.name"), class: "field-label" %>
      <%= f.text_field :name, required: true, class: "input w-full font-body", placeholder: t("owner.restaurants.form.name_placeholder") %>
    </div>

    <%# Only offered once the restaurant exists: on the new form the slug is
        still being derived from the name, and showing an empty field would
        invite owners to fill it in before they have seen what it defaults to. %>
    <% unless restaurant.new_record? %>
      <div class="field">
        <%= f.label :slug, t("owner.restaurants.form.slug"), class: "field-label" %>
        <%= f.text_field :slug, class: "input w-full font-mono", placeholder: restaurant.slug %>
        <p class="field-hint">
          <%= t("owner.restaurants.form.slug_hint", url: restaurant_menu_url(restaurant_slug: restaurant.slug)) %>
        </p>
      </div>
    <% end %>

    <%# The address drives stimulus-autocomplete: the controller names, targets
        and actions below are load-bearing — restyle around them, never rename. %>
    <div class="field relative"
         data-controller="autocomplete address-autocomplete"
         data-autocomplete-url-value="<%= owner_address_suggestions_path %>"
         data-autocomplete-min-length-value="3"
         data-action="autocomplete.change->address-autocomplete#select">
      <%= f.label :address, t("owner.restaurants.form.address"), class: "field-label" %>
      <%= f.text_field :address, required: true, autocomplete: "off",
            class: "input w-full font-body",
            placeholder: t("owner.restaurants.form.address_placeholder"),
            data: { autocomplete_target: "input", action: "input->address-autocomplete#clear" } %>
      <ul class="address-suggestions" data-autocomplete-target="results" hidden></ul>
      <%= f.hidden_field :latitude, data: { address_autocomplete_target: "latitude" } %>
      <%= f.hidden_field :longitude, data: { address_autocomplete_target: "longitude" } %>
    </div>

    <div class="field">
      <%= f.label :description, t("owner.restaurants.form.description"), class: "field-label" %>
      <%= f.text_area :description, rows: 3, class: "textarea w-full font-body", placeholder: t("owner.restaurants.form.description_placeholder") %>
    </div>
  </fieldset>

  <fieldset class="form-section">
    <legend class="form-section-title mb-4"><%= t("owner.restaurants.form.section_service") %></legend>

    <div class="field">
      <%= f.label :proximity_radius_meters, t("owner.restaurants.form.proximity_radius"), class: "field-label" %>
      <div class="flex items-baseline gap-2">
        <%= f.number_field :proximity_radius_meters, min: 50, max: 1000, step: 50, class: "input w-28 font-mono num" %>
        <span class="field-hint"><%= t("owner.restaurants.form.meters") %></span>
      </div>
    </div>

    <label class="field-toggle">
      <%= f.check_box :active, class: "toggle toggle-primary" %>
      <span><%= t("owner.restaurants.form.active_label") %></span>
    </label>
  </fieldset>

  <div class="form-actions">
    <%= f.submit class: "btn-wine" %>
    <a href="<%= owner_restaurants_path %>" class="btn-wine-quiet"><%= t("shared.cancel") %></a>
  </div>
<% end %>
