<% content_for(:title) { "#{@restaurant.name} — #{t('owner.wine_lists.title')}" } %>

<div class="mb-8">
  <div class="flex items-center justify-between">
    <h1 class="font-display text-3xl font-light"><%= t("owner.wine_lists.title") %></h1>
    <div class="flex items-center gap-2">
      <% if @restaurant.active? %>
        <a href="<%= menu_path(id: @restaurant.id) %>" target="_blank" rel="noopener" class="btn btn-ghost btn-sm text-xs uppercase tracking-wider">
          <%= icon "eye", css: "size-4" %>
          <%= t("owner.restaurants.preview_menu") %>
        </a>
      <% else %>
        <span class="btn btn-ghost btn-sm btn-disabled text-xs uppercase tracking-wider" title="<%= t("owner.restaurants.preview_inactive_hint") %>">
          <%= icon "eye-slash", css: "size-4" %>
          <%= t("owner.restaurants.preview_menu") %>
        </span>
      <% end %>
      <a href="<%= new_owner_restaurant_wine_list_path(@restaurant) %>" class="btn-wine btn-sm">
        <%= icon "plus", css: "size-4" %>
        <%= t("owner.wine_lists.add") %>
      </a>
    </div>
  </div>
  <p class="text-sm text-base-content/50 mt-2"><%= t("owner.wine_lists.intro") %></p>
</div>

<div class="space-y-2">
  <%# Default "All Wines" list — always present, reflects every available wine. %>
  <div class="flex items-center justify-between p-4 rounded-lg border border-base-content/10 bg-base-200/40">
    <div class="flex items-center gap-3 min-w-0">
      <%= form_with url: toggle_all_wines_owner_restaurant_wine_lists_path(@restaurant), method: :patch, data: { controller: "auto-submit" } do %>
        <%= check_box_tag :active, "1", @restaurant.all_wines_list_active?,
              class: "toggle toggle-primary toggle-sm",
              aria: { label: t("owner.wine_lists.toggle_label") },
              data: { action: "change->auto-submit#submit" } %>
      <% end %>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="font-body font-medium text-sm truncate"><%= t("owner.wine_lists.all_wines") %></span>
          <span class="badge badge-ghost badge-xs"><%= t("owner.wine_lists.default") %></span>
        </div>
        <p class="text-xs text-base-content/50"><%= t("owner.wine_lists.wine_count", count: @available_wine_count) %></p>
      </div>
    </div>

    <a href="<%= owner_restaurant_wines_path(@restaurant) %>" class="btn btn-ghost btn-xs">
      <%= icon "pencil-simple", css: "size-3.5" %>
      <span class="hidden sm:inline"><%= t("owner.wine_lists.manage_wines") %></span>
    </a>
  </div>

  <%# Custom curated lists. %>
  <% if @wine_lists.any? %>
    <div data-controller="list-filter">
      <div class="mb-2 max-w-sm">
        <label for="wine_lists_filter" class="sr-only"><%= t("owner.shared.filter.placeholder") %></label>
        <input type="search"
               id="wine_lists_filter"
               class="input w-full font-body text-sm"
               placeholder="<%= t("owner.shared.filter.placeholder") %>"
               data-list-filter-target="input"
               data-action="input->list-filter#filter">
      </div>

      <div class="space-y-2">
        <% @wine_lists.each do |wine_list| %>
          <div class="flex items-center justify-between p-4 rounded-lg border border-base-content/5 bg-base-100 hover:border-primary/10 transition-all"
               data-list-filter-target="item"
               data-search-terms="<%= wine_list.name.downcase %>">
            <div class="flex items-center gap-3 min-w-0">
              <%= form_with model: [ :owner, @restaurant, wine_list ], method: :patch, data: { controller: "auto-submit" } do |f| %>
                <%= f.check_box :active,
                      class: "toggle toggle-primary toggle-sm",
                      aria: { label: t("owner.wine_lists.toggle_label") },
                      data: { action: "change->auto-submit#submit" } %>
              <% end %>
              <div class="min-w-0">
                <span class="font-body font-medium text-sm truncate"><%= wine_list.name %></span>
                <p class="text-xs text-base-content/50 truncate">
                  <%= [ wine_list.season, t("owner.wine_lists.wine_count", count: wine_list.wine_list_items.size) ].compact_blank.join(" · ") %>
                </p>
              </div>
            </div>

            <div class="flex items-center gap-1 ml-4">
              <a href="<%= edit_owner_restaurant_wine_list_path(@restaurant, wine_list) %>" class="btn btn-ghost btn-xs">
                <%= icon "pencil-simple", css: "size-3.5" %>
              </a>
              <%= button_to owner_restaurant_wine_list_path(@restaurant, wine_list), method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: t("owner.wine_lists.confirm_delete") } do %>
                <%= icon "trash", css: "size-3.5" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <p data-list-filter-target="empty" hidden class="text-sm text-base-content/50 text-center py-8">
        <%= t("owner.shared.filter.no_results") %>
      </p>
    </div>
  <% end %>
</div>
