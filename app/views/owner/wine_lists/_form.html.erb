<%= form_with model: [:owner, @restaurant, wine_list], class: "space-y-8 max-w-xl" do |f| %>
  <% if wine_list.errors.any? %>
    <div role="alert" class="alert alert-error text-sm">
      <%= icon "warning", css: "size-4" %>
      <div>
        <% wine_list.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <fieldset class="form-section">
    <div class="field">
      <%= f.label :name, t("owner.wine_lists.form.name"), class: "field-label" %>
      <%= f.text_field :name, required: true, class: "input w-full font-body", placeholder: t("owner.wine_lists.form.name_placeholder") %>
    </div>

    <div class="grid sm:grid-cols-[1fr_auto] gap-4">
      <div class="field">
        <%= f.label :season, t("owner.wine_lists.form.season"), class: "field-label" %>
        <%= f.text_field :season, class: "input w-full font-body", placeholder: t("owner.wine_lists.form.season_placeholder") %>
      </div>

      <div class="field">
        <%= f.label :position, t("owner.wine_lists.form.position"), class: "field-label" %>
        <%= f.number_field :position, min: 0, class: "input w-28 font-body" %>
      </div>
    </div>

    <label class="field-toggle">
      <%= f.check_box :active, class: "toggle toggle-primary" %>
      <span><%= t("owner.wine_lists.form.active_label") %></span>
    </label>
  </fieldset>

  <div class="form-actions">
    <%= f.submit class: "btn-wine" %>
    <a href="<%= owner_restaurant_wine_lists_path(@restaurant) %>" class="btn btn-ghost text-xs uppercase tracking-wider"><%= t("shared.cancel") %></a>
  </div>
<% end %>
