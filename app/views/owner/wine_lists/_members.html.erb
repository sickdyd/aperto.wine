<section id="wine_list_members" class="max-w-2xl">
  <h2 class="font-display text-xl font-light mb-1"><%= t("owner.wine_lists.members.title") %></h2>
  <p class="text-sm text-base-content/50 mb-6"><%= t("owner.wine_lists.members.intro") %></p>

  <%# Current members %>
  <% items = wine_list.wine_list_items.includes(:wine).by_position %>
  <% if items.any? %>
    <div class="space-y-2 mb-8">
      <%= render partial: "owner/wine_lists/member_item", collection: items, as: :item, locals: { wine_list: wine_list } %>
    </div>
  <% else %>
    <p class="text-sm text-base-content/40 italic mb-8"><%= t("owner.wine_lists.members.empty") %></p>
  <% end %>

  <%# Add a wine from the restaurant's shared catalog (reuse the already-loaded
      items to avoid an extra query) %>
  <% available_wines = @restaurant.wines.by_position.where.not(id: items.map(&:wine_id)) %>
  <% if available_wines.any? %>
    <%= form_with url: owner_restaurant_wine_list_wine_list_items_path(@restaurant, wine_list), method: :post, class: "flex items-end gap-3" do |f| %>
      <div class="field flex-1">
        <%= f.label :wine_id, t("owner.wine_lists.members.add_label"), class: "field-label" %>
        <%= f.select :wine_id, available_wines.map { |w| [w.name, w.id] }, {}, class: "select w-full font-body" %>
      </div>
      <%= f.submit t("owner.wine_lists.members.add"), class: "btn-wine btn-sm" %>
    <% end %>
    <a href="<%= owner_restaurant_wines_path(@restaurant) %>" class="inline-block mt-3 text-xs text-base-content/50 link link-hover">
      <%= t("owner.wine_lists.manage_wines") %>
    </a>
  <% elsif items.any? %>
    <p class="text-xs text-base-content/40"><%= t("owner.wine_lists.members.all_added") %></p>
  <% else %>
    <p class="text-sm text-base-content/50 mb-3"><%= t("owner.wine_lists.members.no_wines") %></p>
    <a href="<%= owner_restaurant_wines_path(@restaurant) %>" class="btn-wine btn-sm">
      <%= icon "wine", css: "size-4" %>
      <%= t("owner.wine_lists.members.go_to_wines") %>
    </a>
  <% end %>
</section>
