<%# A member row. Must stay a DIRECT child of the [data-sortable-target="members"]
    container and keep data-id / data-color: the sortable controller reads
    container.children for the flat position sequence and gates drops on colour.

    The row wraps below `sm`: the name takes the full width and the remove
    control drops to a second line, rather than crushing the name. %>
<div class="flex flex-wrap items-center gap-x-3 gap-y-1 py-2" data-id="<%= item.id %>" data-color="<%= item.wine.color %>">
  <div class="flex min-w-0 grow basis-full items-baseline gap-2 sm:basis-auto">
    <%# touch-none is load-bearing: it scopes touch-action to the handle so the
        row itself can still be scrolled on a phone. %>
    <span data-sortable-handle
          aria-label="<%= t("owner.wine_lists.members.drag_label") %>"
          title="<%= t("owner.wine_lists.members.drag_label") %>"
          class="-ml-1 inline-flex shrink-0 cursor-grab touch-none self-center p-1 text-ink-soft hover:text-ox-2">
      <%= icon "dots-six-vertical", class: "size-4" %>
    </span>
    <%= wine_color_dot(item.wine.color) %>
    <%# The out-of-stock tag hangs under the name rather than beside it: side by
        side it wins the space fight in a narrow column and squeezes the name to
        nothing. %>
    <div class="min-w-0">
      <span class="wine-name block truncate"><%= item.wine.name %></span>
      <%# Widened to #available? — a bottle-only wine (no glasses, a bottle
          price) is orderable now that the menu offers bottle controls, so
          labelling it "unavailable" here would be wrong for the same reason
          it would be on the menu. %>
      <% unless item.wine.available? %>
        <span class="tag-out mt-1 whitespace-nowrap"><%= t("menu.unavailable") %></span>
      <% end %>
    </div>
  </div>

  <%# Labelled, not an icon-only trash can: this deletes the join row, so the
      wine stays in the cellar and goes back to the catalogue column. A bare
      bin reads as "delete this wine" and is the one thing it never does.
      Mirrors the "＋ Add to list" control on the other side of the editor. %>
  <div class="ml-auto flex shrink-0 items-center gap-1">
    <%= button_to owner_restaurant_wine_list_wine_list_item_path(@restaurant, wine_list, item),
          method: :delete,
          class: "btn-wine-quiet min-h-11 px-2",
          aria: { label: "#{t('owner.wine_lists.members.remove_from_list')}: #{item.wine.name}" } do %>
      <%= icon "minus", class: "size-4" %>
      <span><%= t("owner.wine_lists.members.remove_from_list") %></span>
    <% end %>
  </div>
</div>
