<% content_for(:title) { "#{@restaurant.name} — #{t('owner.tables.title')}" } %>
<% table_count = @grouped_tables.values.sum(&:size) %>

<div class="admin-head">
  <div>
    <h1 class="admin-title"><%= t("owner.tables.title") %></h1>
    <p class="admin-subtitle mt-1"><%= t("owner.tables.table_count", count: table_count) %></p>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <% if @grouped_tables.any? %>
      <a href="<%= bulk_print_owner_restaurant_tables_path(@restaurant) %>" class="btn-wine-quiet">
        <%= icon "printer", css: "size-4" %>
        <%= t("owner.tables.print_all") %>
      </a>
    <% end %>
    <a href="<%= bulk_new_owner_restaurant_tables_path(@restaurant) %>" class="btn-wine-outline">
      <%= icon "magic-wand", css: "size-4" %>
      <%= t("owner.tables.bulk.generate") %>
    </a>
    <a href="<%= new_owner_restaurant_table_path(@restaurant) %>" class="btn-wine">
      <%= icon "plus", css: "size-4" %>
      <%= t("owner.tables.add") %>
    </a>
  </div>
</div>

<p class="note measure mb-8"><%= t("owner.tables.intro") %></p>

<% if @grouped_tables.any? %>
  <div class="space-y-10">
    <% @grouped_tables.each do |area, tables| %>
      <% area_name = area.presence || t("owner.tables.no_area") %>
      <section>
        <%# px-3 so the room title hangs on the same left edge as the column
            heads and the cells below it. %>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 px-3">
          <h2 class="list-title"><%= area_name %></h2>
          <a href="<%= bulk_print_owner_restaurant_tables_path(@restaurant, area: area) %>" class="link-mono">
            <%= icon "printer", css: "size-4 me-1.5" %>
            <%= t("owner.tables.print_area") %>
          </a>
        </div>

        <table class="ledger-table">
          <caption class="sr-only"><%= area_name %></caption>
          <thead>
            <tr>
              <th scope="col"><%= t("owner.tables.table.name") %></th>
              <th scope="col" class="text-right"><span class="sr-only"><%= t("owner.tables.table.actions") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% tables.each do |table| %>
              <tr>
                <td class="align-middle">
                  <div class="flex items-baseline gap-2">
                    <span class="font-medium"><%= table.name %></span>
                    <% unless table.active? %>
                      <span class="tag-out"><%= t("owner.tables.inactive") %></span>
                    <% end %>
                  </div>
                </td>
                <td class="w-px align-middle whitespace-nowrap">
                  <div class="flex items-center justify-end gap-1">
                    <a href="<%= qr_owner_restaurant_table_path(@restaurant, table) %>" class="link-mono px-2">
                      <%= icon "qr-code", css: "size-4 me-1.5" %>
                      <%= t("owner.tables.view_qr") %>
                    </a>
                    <a href="<%= edit_owner_restaurant_table_path(@restaurant, table) %>" class="link-mono" aria-label="<%= t("owner.tables.edit_table", name: table.name) %>">
                      <%= icon "pencil-simple", css: "size-4" %>
                    </a>

                    <%# The destructive action is kept off on its own side of a
                        hairline, so it is never the neighbour of a mis-tap. %>
                    <span class="ms-2 ps-2 border-s border-rule-hair">
                      <%= button_to owner_restaurant_table_path(@restaurant, table),
                                    method: :delete,
                                    class: "link-mono text-error hover:text-error",
                                    aria: { label: t("owner.tables.delete_table", name: table.name) },
                                    data: { turbo_confirm: t("owner.tables.confirm_delete") } do %>
                        <%= icon "trash", css: "size-4" %>
                      <% end %>
                    </span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <h2 class="not-italic"><%= t("owner.tables.empty_title") %></h2>
    <p class="measure mx-auto mt-2"><%= t("owner.tables.empty_description") %></p>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
      <a href="<%= bulk_new_owner_restaurant_tables_path(@restaurant) %>" class="btn-wine">
        <%= icon "magic-wand", css: "size-4" %>
        <%= t("owner.tables.bulk.generate") %>
      </a>
      <a href="<%= new_owner_restaurant_table_path(@restaurant) %>" class="btn-wine-outline">
        <%= icon "plus", css: "size-4" %>
        <%= t("owner.tables.add_first") %>
      </a>
    </div>
  </div>
<% end %>
