<% content_for(:title) { "#{@restaurant.name} — #{t('owner.tables.qr_title', table: @table.name)}" } %>

<div class="admin-head print:hidden">
  <div>
    <h1 class="admin-title"><%= t("owner.tables.qr_title", table: @table.name) %></h1>
    <p class="admin-subtitle mt-1"><%= @table.area.presence || t("owner.tables.no_area") %></p>
  </div>

  <button type="button" onclick="window.print()" class="btn-wine">
    <%= icon "printer", css: "size-4" %>
    <%= t("owner.tables.print") %>
  </button>
</div>

<div class="grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] print:block">
  <%# The card as it will be printed and stood on the table. %>
  <div>
    <%= render "qr_card",
               restaurant: @restaurant,
               qr_svg: @qr_svg,
               id: "qr-code",
               stamp_label: @table.name,
               sub_label: @table.area.presence,
               extra_class: "sheet-narrow qr-card-single" %>
  </div>

  <div class="space-y-8 print:hidden">
    <p class="note measure"><%= t("owner.tables.qr_description") %></p>

    <div class="field">
      <label class="field-label" for="menu-url"><%= t("owner.qr_code.menu_link") %></label>
      <div class="flex items-end gap-2">
        <input type="text" value="<%= @menu_url %>" readonly class="input w-full font-body" id="menu-url">
        <button type="button"
                onclick="navigator.clipboard.writeText(document.getElementById('menu-url').value)"
                class="btn-wine-quiet"
                aria-label="<%= t("owner.qr_code.copy_link") %>">
          <%= icon "copy", css: "size-4" %>
        </button>
      </div>
      <p class="field-hint"><%= t("owner.tables.qr_hint") %></p>
    </div>

    <hr class="rule-hair">

    <a href="<%= owner_restaurant_tables_path(@restaurant) %>" class="link-mono">
      <%= icon "arrow-left", css: "size-4 me-1.5" %>
      <%= t("owner.tables.back_to_tables") %>
    </a>
  </div>
</div>

<%= render "print_styles" %>
