<% content_for(:title) { "#{@restaurant.name} — #{t('owner.tables.bulk_print_title')}" } %>

<div class="admin-head print:hidden" id="bulk-print-header">
  <div>
    <h1 class="admin-title"><%= t("owner.tables.bulk_print_title") %></h1>
    <p class="admin-subtitle mt-1"><%= params[:area].presence || t("owner.tables.all_areas") %></p>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <a href="<%= owner_restaurant_tables_path(@restaurant) %>" class="btn-wine-quiet">
      <%= icon "arrow-left", css: "size-4" %>
      <%= t("owner.tables.back_to_tables") %>
    </a>
    <button type="button" onclick="window.print()" class="btn-wine">
      <%= icon "printer", css: "size-4" %>
      <%= t("owner.tables.print") %>
    </button>
  </div>
</div>

<% if @grouped_tables.any? %>
  <p class="note measure mb-8 print:hidden"><%= t("owner.tables.print_hint") %></p>

  <div class="space-y-12" id="qr-sheet">
    <% @grouped_tables.each do |area, tables| %>
      <section class="qr-area">
        <h2 class="group-title qr-area-title mb-4">
          <%= area.presence || t("owner.tables.no_area") %>
        </h2>

        <div class="qr-grid grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% tables.each do |table| %>
            <%= render "qr_card",
                       restaurant: @restaurant,
                       qr_svg: @table_qr_svgs[table],
                       stamp_label: table.name,
                       sub_label: table.area.presence %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <p class="not-italic"><%= t("owner.tables.empty_title") %></p>
  </div>
<% end %>

<%= render "print_styles" %>
