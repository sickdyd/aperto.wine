<% content_for(:title) { "#{@restaurant.name} — #{t('owner.tables.bulk.title')}" } %>

<div class="admin-head">
  <h1 class="admin-title"><%= t("owner.tables.bulk.title") %></h1>
</div>

<p class="note measure mb-8"><%= t("owner.tables.bulk.intro") %></p>

<%= form_with model: @generation, url: bulk_create_owner_restaurant_tables_path(@restaurant), scope: :table_bulk_generation, class: "max-w-xl space-y-8" do |f| %>
  <% if @generation.errors.any? %>
    <div role="alert" class="alert alert-error">
      <%= icon "warning", class: "size-4 shrink-0" %>
      <div>
        <% @generation.errors.full_messages.each do |msg| %>
          <p class="field-error"><%= msg %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <fieldset class="form-section">
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="field">
        <%= f.label :floors_count, t("owner.tables.bulk.floors_count"), class: "field-label" %>
        <%= f.number_field :floors_count, min: 1, max: TableBulkGeneration::MAX_FLOORS, required: true, class: "input w-full font-body num" %>
      </div>
      <div class="field">
        <%= f.label :tables_per_floor, t("owner.tables.bulk.tables_per_floor"), class: "field-label" %>
        <%= f.number_field :tables_per_floor, min: 1, max: TableBulkGeneration::MAX_TABLES_PER_FLOOR, required: true, class: "input w-full font-body num" %>
      </div>
    </div>

    <div class="field">
      <%= f.label :floor_label, t("owner.tables.bulk.floor_label"), class: "field-label" %>
      <%= f.text_field :floor_label, class: "input w-full font-body" %>
      <p class="field-hint"><%= t("owner.tables.bulk.floor_label_hint") %></p>
    </div>
  </fieldset>

  <fieldset class="form-section">
    <legend class="form-section-title"><%= t("owner.tables.bulk.name_pattern") %></legend>
    <%# Ruled rows rather than boxes: a hairline between choices, nothing framed. %>
    <%# No closing rule: the form-actions rule below already shuts the list. %>
    <div class="divide-y divide-rule-hair">
      <% TableBulkGeneration::NAME_PATTERNS.each do |pattern| %>
        <label class="field-toggle min-h-11">
          <%= f.radio_button :name_pattern, pattern, class: "radio radio-primary radio-sm" %>
          <span><%= t("owner.tables.bulk.patterns.#{pattern}") %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= f.submit t("owner.tables.bulk.submit"), class: "btn-wine" %>
    <a href="<%= owner_restaurant_tables_path(@restaurant) %>" class="btn-wine-quiet"><%= t("shared.cancel") %></a>
  </div>
<% end %>
