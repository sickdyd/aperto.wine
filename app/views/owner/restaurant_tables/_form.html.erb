<%# The route is `resources :tables` while the model is RestaurantTable, so the
    polymorphic helper doesn't resolve — pass url + scope explicitly. %>
<%= form_with model: table, url: table.persisted? ? owner_restaurant_table_path(@restaurant, table) : owner_restaurant_tables_path(@restaurant), scope: :restaurant_table, class: "space-y-6 max-w-2xl" do |f| %>
  <% if table.errors.any? %>
    <div role="alert" class="alert alert-error text-sm">
      <%= icon "warning", css: "size-4" %>
      <div>
        <% table.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <fieldset class="space-y-4">
    <div class="form-control">
      <%= f.label :name, t("owner.tables.form.name"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
      <%= f.text_field :name, required: true, class: "input input-bordered w-full font-body", placeholder: t("owner.tables.form.name_placeholder") %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div class="form-control">
        <%= f.label :area, t("owner.tables.form.area"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.text_field :area, class: "input input-bordered w-full font-body", placeholder: t("owner.tables.form.area_placeholder"), list: "table-areas" %>
        <datalist id="table-areas">
          <% @restaurant.restaurant_tables.distinct.pluck(:area).compact_blank.each do |area| %>
            <option value="<%= area %>"></option>
          <% end %>
        </datalist>
      </div>

      <div class="form-control">
        <%= f.label :position, t("owner.tables.form.position"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.number_field :position, min: 0, class: "input input-bordered w-32 font-body" %>
      </div>
    </div>

    <div class="form-control">
      <label class="label cursor-pointer justify-start gap-3">
        <%= f.check_box :active, class: "toggle toggle-primary" %>
        <span class="label-text font-body"><%= t("owner.tables.form.active_label") %></span>
      </label>
    </div>
  </fieldset>

  <div class="flex items-center gap-3 pt-4">
    <%= f.submit class: "btn-wine" %>
    <a href="<%= owner_restaurant_tables_path(@restaurant) %>" class="btn btn-ghost text-xs uppercase tracking-wider"><%= t("shared.cancel") %></a>
  </div>
<% end %>
