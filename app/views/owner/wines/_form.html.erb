<%= form_with model: [:owner, @restaurant, wine], class: "space-y-6 max-w-2xl" do |f| %>
  <% if wine.errors.any? %>
    <div role="alert" class="alert alert-error text-sm">
      <%= icon "warning", css: "size-4" %>
      <div>
        <% wine.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Basic info %>
  <fieldset class="space-y-4">
    <legend class="font-body text-xs uppercase tracking-[0.15em] text-base-content/50 mb-2"><%= t("owner.wines.form.basic_info") %></legend>

    <div class="form-control">
      <%= f.label :name, t("owner.wines.form.name"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
      <%= f.text_field :name, required: true, class: "input input-bordered w-full font-body", placeholder: t("owner.wines.form.name_placeholder") %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div class="form-control">
        <%= f.label :producer, t("owner.wines.form.producer"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.text_field :producer, class: "input input-bordered w-full font-body" %>
      </div>

      <div class="form-control">
        <%= f.label :grape_variety, t("owner.wines.form.grape_variety"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.text_field :grape_variety, class: "input input-bordered w-full font-body", placeholder: t("owner.wines.form.grape_placeholder") %>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div class="form-control">
        <%= f.label :color, t("owner.wines.form.color"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.select :color, Wine.colors.keys.map { |c| [t("owner.wines.colors.#{c}"), c] }, {}, class: "select select-bordered w-full font-body" %>
      </div>

      <div class="form-control">
        <%= f.label :vintage_year, t("owner.wines.form.vintage_year"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.number_field :vintage_year, min: 1900, max: Date.current.year, class: "input input-bordered w-full font-body" %>
      </div>

      <div class="form-control">
        <%= f.label :region, t("owner.wines.form.region"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.text_field :region, class: "input input-bordered w-full font-body", placeholder: t("owner.wines.form.region_placeholder") %>
      </div>
    </div>

    <div class="form-control">
      <%= f.label :description, t("owner.wines.form.description"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
      <%= f.text_area :description, rows: 2, class: "textarea textarea-bordered w-full font-body" %>
    </div>
  </fieldset>

  <%# Pricing %>
  <fieldset class="space-y-4">
    <legend class="font-body text-xs uppercase tracking-[0.15em] text-base-content/50 mb-2"><%= t("owner.wines.form.pricing") %></legend>

    <div class="grid grid-cols-2 gap-4">
      <div class="form-control">
        <%= f.label :bottle_size_ml, t("owner.wines.form.bottle_size"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <div class="flex items-center gap-2">
          <%= f.number_field :bottle_size_ml, min: 187, max: 3000, step: 1, class: "input input-bordered w-32 font-body" %>
          <span class="text-sm text-base-content/50">ml</span>
        </div>
      </div>

      <div class="form-control">
        <%= f.label :price_bottle_cents, t("owner.wines.form.price_bottle"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <div class="flex items-center gap-2">
          <span class="text-sm text-base-content/50">&euro;</span>
          <%= f.number_field :price_bottle_cents, min: 0, step: 1, class: "input input-bordered w-32 font-body", placeholder: t("owner.wines.form.cents_hint") %>
        </div>
      </div>
    </div>

    <p class="text-xs text-base-content/40"><%= t("owner.wines.form.glass_prices_hint") %></p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <% Wine::GLASS_SIZES.each do |size| %>
        <div class="form-control">
          <%= f.label :"price_#{size}ml_cents", "#{size}ml", class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
          <div class="flex items-center gap-1">
            <span class="text-xs text-base-content/50">&euro;</span>
            <%= f.number_field :"price_#{size}ml_cents", min: 0, step: 1, class: "input input-bordered w-full font-body input-sm", placeholder: "cents" %>
          </div>
        </div>
      <% end %>
    </div>
  </fieldset>

  <%# Availability %>
  <fieldset class="space-y-4">
    <legend class="font-body text-xs uppercase tracking-[0.15em] text-base-content/50 mb-2"><%= t("owner.wines.form.availability") %></legend>

    <div class="grid grid-cols-2 gap-4">
      <div class="form-control">
        <%= f.label :available_glasses, t("owner.wines.form.available_glasses"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.number_field :available_glasses, min: 0, class: "input input-bordered w-32 font-body" %>
        <p class="label text-xs text-base-content/40">
          <%= t("owner.wines.form.suggested") %>:
          <% Wine::GLASS_SIZES.each do |size| %>
            <span class="font-medium"><%= (wine.bottle_size_ml || 750) / size %></span> &times; <%= size %>ml<%= size == Wine::GLASS_SIZES.last ? "" : "," %>
          <% end %>
        </p>
      </div>

      <div class="form-control">
        <%= f.label :position, t("owner.wines.form.position"), class: "label font-body text-xs uppercase tracking-wider text-base-content/60" %>
        <%= f.number_field :position, min: 0, class: "input input-bordered w-32 font-body" %>
      </div>
    </div>

    <div class="form-control">
      <label class="label cursor-pointer justify-start gap-3">
        <%= f.check_box :active, class: "toggle toggle-primary" %>
        <span class="label-text font-body"><%= t("owner.wines.form.active_label") %></span>
      </label>
    </div>
  </fieldset>

  <div class="flex items-center gap-3 pt-4">
    <%= f.submit class: "btn-wine" %>
    <a href="<%= owner_restaurant_wines_path(@restaurant) %>" class="btn btn-ghost text-xs uppercase tracking-wider"><%= t("shared.cancel") %></a>
  </div>
<% end %>
