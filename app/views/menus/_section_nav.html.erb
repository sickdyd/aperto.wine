<%# Locals: sections (required) — [dom_id, label] pairs, one per rendered menu
    section, in page order (see MenusHelper#menu_nav_sections).

    Sticky jump navigation, ruled into the sheet and bleeding to its edges (see
    ".jump-nav"). Chips are plain anchors so navigation works without JS;
    smooth scrolling comes from the scroll-smooth class on <html> and the
    scroll-margin ".group" puts above each colour section. %>
<nav aria-label="<%= t("menu.sections_nav_label") %>" class="jump-nav">
  <ul>
    <% sections.each do |dom_id, label| %>
      <%# min-w-11: short labels ("Red") would otherwise fall under the 44px
          minimum tap target that ".chip" already holds vertically. %>
      <li><a href="#<%= dom_id %>" class="chip min-w-11 justify-center"><%= label %></a></li>
    <% end %>
  </ul>
</nav>
