<% content_for(:title) { "#{@restaurant.name} — #{t('menu.title')}" } %>

<div class="min-h-screen max-w-2xl mx-auto px-4 py-8">
  <%# Header %>
  <header class="text-center mb-10">
    <h1 class="font-display text-3xl font-light"><%= @restaurant.name %></h1>
    <p class="text-sm text-base-content/50 mt-1"><%= @restaurant.address %></p>
    <div class="divider-wine mt-6"></div>
  </header>

  <%# Search and filters (placeholder for now) %>
  <div class="mb-8">
    <input type="search" placeholder="<%= t('menu.search_placeholder') %>" class="input input-bordered w-full font-body text-sm" data-controller="menu-search">
  </div>

  <%# Wine list grouped by color %>
  <% if @wines.any? %>
    <% @wines.group_by(&:color).each do |color, wines| %>
      <section class="mb-10">
        <h2 class="font-display text-xl font-medium mb-4 flex items-center gap-2">
          <span class="inline-block w-3 h-3 rounded-full <%= wine_color_class(color) %>"></span>
          <%= t("owner.wines.colors.#{color}") %>
        </h2>

        <div class="space-y-3">
          <% wines.each do |wine| %>
            <% open_bottle = wine.wine_bottles.find_by(status: :open) %>
            <div class="p-4 rounded-lg border border-base-content/5 <%= wine.available? ? '' : 'opacity-50' %>">
              <div class="flex items-start justify-between">
                <div class="shrink-0 mr-3 self-center">
                  <%= bottle_icon(wine, bottle: open_bottle, size: :sm) %>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-body font-medium text-sm"><%= wine.name %></h3>
                  <p class="text-xs text-base-content/50 mt-0.5">
                    <%= [wine.producer, wine.grape_variety, wine.vintage_year, wine.region].compact_blank.join(" · ") %>
                  </p>
                </div>

                <% if wine.available? %>
                  <div class="text-right ml-4">
                    <% Wine::GLASS_SIZES.each do |size| %>
                      <% price = wine.price_for_glass(size) %>
                      <% if price&.positive? %>
                        <span class="inline-block text-xs text-base-content/60 ml-2">
                          <%= size %>ml <span class="font-medium text-base-content"><%= format_cents(price) %></span>
                        </span>
                      <% end %>
                    <% end %>
                  </div>
                <% else %>
                  <span class="badge badge-ghost badge-sm"><%= t("shared.sold_out") %></span>
                <% end %>
              </div>

              <% if wine.description.present? %>
                <p class="text-xs text-base-content/40 mt-2 italic"><%= wine.description %></p>
              <% end %>

              <%# Show opened_at for open bottles %>
              <% if open_bottle&.opened_at %>
                <p class="text-xs text-primary/60 mt-2 flex items-center gap-1">
                  <%= icon "clock", css: "size-3" %>
                  <%= t("menu.opened_at", time: time_ago_in_words(open_bottle.opened_at)) %>
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="text-center py-16">
      <p class="text-base-content/50"><%= t("menu.empty") %></p>
    </div>
  <% end %>

  <%# Footer %>
  <footer class="text-center mt-12 pt-6 border-t border-base-content/5">
    <p class="text-xs text-base-content/30">
      <%= t("menu.powered_by") %>
      <a href="<%= root_path %>" class="text-primary/60 hover:text-primary">Wine Sharing</a>
    </p>
  </footer>
</div>
