<% content_for(:title) { "#{@restaurant.name} — #{t('menu.title')}" } %>

<%# The guest's sheet: a lighter stock laid on the menu band, no wider than a
    card held in one hand. Extra bottom padding keeps the sticky cart bar from
    covering the last wine row once it appears (see the "cart_bar" partial at
    the foot of this file). %>
<main id="main" class="band-stock flex-1 <%= "pb-32" unless @cart.empty? %>">
  <div class="sheet sheet-narrow">
    <header class="sheet-head">
      <h1 class="display-3 press"><%= @restaurant.name %></h1>
      <p class="sheet-address"><%= @restaurant.address %></p>
      <% if @restaurant_table %>
        <%# The table label is owner-defined (e.g. "Tavolo 3"), shown as-is.
            The page's one ink stamp — see the vocabulary's ".stamp". %>
        <p class="mt-4"><span class="stamp"><%= @restaurant_table.name %></span></p>
      <% end %>

      <%# Only once this device has actually ordered here: a first-time diner
          must find nothing new on the sheet. The list itself lives in a signed
          24-hour cookie, so this link comes and goes with it. %>
      <% if @order_history.any? %>
        <p class="mt-2">
          <a href="<%= orders_path(restaurant_slug: @restaurant.slug) %>" class="link-mono gap-2">
            <%= icon "receipt", class: "size-3.5" %>
            <%= t("orders.history.title") %>
          </a>
        </p>
      <% end %>
    </header>

    <%# Render every enabled curated list, each grouped into colour sections in
        wine colour enum order. Curated lists hide deactivated wines entirely;
        active wines with no glasses still render with the "unavailable" tag. %>
    <% rendered_lists = renderable_wine_lists(@wine_lists) %>

    <% if rendered_lists.any? %>
      <div data-controller="list-filter">
        <div class="mt-6">
          <label for="menu_search" class="mono-label mb-2 block text-ox-2"><%= t("menu.search_label") %></label>
          <div class="search-field">
            <%= icon "magnifying-glass", class: "size-4", "aria-hidden": "true" %>
            <input type="search"
                   id="menu_search"
                   placeholder="<%= t('menu.search_placeholder') %>"
                   autocomplete="off"
                   spellcheck="false"
                   data-list-filter-target="input"
                   data-action="input->list-filter#filter">
          </div>
        </div>

        <%# Filter chips, one row per facet, derived from the wines actually
            rendered below — never a hardcoded list — and only for a facet
            with at least two distinct values among them (a chip row where
            every chip matches everything is noise). Region and grape are
            deliberately left out: on a real list they run to dozens of
            values each, and the search field above already reaches both, so
            a chip row for either would be scroll-length filter-bar chrome
            rather than a shortcut. %>
        <% filters = menu_filter_facets(rendered_lists) %>
        <% if filters[:groups].any? %>
          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
            <% filters[:groups].each do |group| %>
              <div role="group" aria-label="<%= group[:label] %>" class="flex flex-wrap gap-1.5">
                <% group[:options].each do |option| %>
                  <button type="button"
                          class="chip min-w-11 justify-center"
                          aria-pressed="false"
                          data-list-filter-target="facet"
                          data-facet-name="<%= group[:name] %>"
                          data-facet-value="<%= option[:value] %>"
                          data-action="click->list-filter#toggleFacet">
                    <%= option[:label] %>
                  </button>
                <% end %>
              </div>
            <% end %>
            <%# Shown only once a term or a chip is active — toggled by the
                controller's #apply, never rendered visible here. %>
            <button type="button"
                    class="link-mono"
                    hidden
                    data-list-filter-target="clear"
                    data-action="click->list-filter#clearAll">
              <%= t("menu.filters.clear_all") %>
            </button>
          </div>
        <% end %>

        <% nav_sections = menu_nav_sections(rendered_lists) %>
        <% if nav_sections.size > 1 %>
          <%= render "section_nav", sections: nav_sections %>
        <% end %>

        <% rendered_lists.each do |wine_list, colour_groups| %>
          <%# Also a filter group, nested around the colour sections: without
              this a list whose wines all filter out would leave a bare heading
              behind. %>
          <section class="mt-8" data-list-filter-target="group"
                   aria-labelledby="list-<%= wine_list.id %>-title">
            <div class="list-head">
              <h2 id="list-<%= wine_list.id %>-title" class="list-title font-body"><%= wine_list.name %></h2>
              <span class="leader leader-solid" aria-hidden="true"></span>
              <% if wine_list.season.present? %>
                <span class="mono-micro num shrink-0 text-ox-3"><%= wine_list.season %></span>
              <% end %>
            </div>

            <% colour_groups.each do |colour, items| %>
              <%# The jump-nav anchor. ".group" carries the scroll-margin that
                  keeps the heading clear of the sticky nav above it. %>
              <section id="list-<%= wine_list.id %>-<%= colour %>"
                       class="wine-group"
                       data-list-filter-target="group"
                       aria-labelledby="list-<%= wine_list.id %>-<%= colour %>-title">
                <div class="group-head">
                  <h3 id="list-<%= wine_list.id %>-<%= colour %>-title" class="group-title">
                    <%= wine_color_dot(colour, label: false) %>
                    <%= t("owner.wines.colors.#{colour}") %>
                  </h3>
                  <span class="leader leader-solid" aria-hidden="true"></span>
                </div>

                <ul class="group-body">
                  <% items.each do |item| %>
                    <%= render "wine_row", wine: item.wine, restaurant: @restaurant, unavailable_label: t("menu.unavailable"),
                          facet_values: filters[:wine_values].fetch(item.wine, {}) %>
                  <% end %>
                </ul>
              </section>
            <% end %>
          </section>
        <% end %>

        <p data-list-filter-target="empty" hidden class="empty-state">
          <%= t("menu.no_results") %>
        </p>
      </div>
    <% else %>
      <p class="empty-state"><%= t("menu.empty") %></p>
    <% end %>

    <footer class="sheet-foot">
      <%= t("menu.powered_by") %>
      <a href="<%= root_path %>" class="underline decoration-ox-4 underline-offset-4 hover:text-ox-1">aperto.wine</a>
      <%# A diner never leaves the menu, so this is the only foot most of them
          will ever see — the informativa has to be reachable from it. %>
      <span class="block mt-2">
        <a href="<%= privacy_path %>" class="underline decoration-ox-4 underline-offset-4 hover:text-ox-1"><%= t("legal.nav.privacy") %></a>
        &middot;
        <a href="<%= terms_path %>" class="underline decoration-ox-4 underline-offset-4 hover:text-ox-1"><%= t("legal.nav.terms") %></a>
      </span>
    </footer>
  </div>
</main>

<% unless @cart.empty? %>
  <%= render "cart_bar", cart: @cart, restaurant: @restaurant %>
<% end %>
