<% content_for(:title) { "#{@restaurant.name} — #{t('menu.title')}" } %>

<div class="min-h-screen max-w-2xl mx-auto px-4 py-8">
  <%# Header %>
  <header class="text-center mb-10">
    <h1 class="font-display text-3xl font-light"><%= @restaurant.name %></h1>
    <p class="text-sm text-base-content/50 mt-1"><%= @restaurant.address %></p>
    <% if @restaurant_table %>
      <%# The table label is owner-defined (e.g. "Tavolo 3"), shown as-is. %>
      <span class="badge badge-ghost badge-sm mt-3 font-body"><%= @restaurant_table.name %></span>
    <% end %>
    <div class="divider-wine mt-6"></div>
  </header>

  <%# Search and filters (placeholder for now) %>
  <div class="mb-8">
    <input type="search" placeholder="<%= t('menu.search_placeholder') %>" class="input w-full font-body text-sm" data-controller="menu-search">
  </div>

  <%# Render every enabled list: published curated lists first, then the
      default "All Wines" list (the full menu grouped by color) if enabled. %>
  <% all_wines = @show_all_wines ? @wines.to_a : [] %>
  <% rendered_any = false %>

  <% @wine_lists.each do |wine_list| %>
    <%# Hide deactivated wines entirely (like the flat list); active wines with
        no glasses still render with the "currently unavailable" badge. %>
    <% items = wine_list.wine_list_items.select { |i| i.wine.active? }.sort_by { |i| [i.position, i.id] } %>
    <% next if items.empty? %>
    <% rendered_any = true %>
    <section class="mb-10">
      <h2 class="font-display text-xl font-medium mb-1"><%= wine_list.name %></h2>
      <% if wine_list.season.present? %>
        <p class="text-xs uppercase tracking-[0.15em] text-base-content/40 mb-4"><%= wine_list.season %></p>
      <% else %>
        <div class="mb-4"></div>
      <% end %>

      <div class="space-y-3">
        <% items.each do |item| %>
          <%= render "wine_row", wine: item.wine, unavailable_label: t("menu.unavailable") %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if all_wines.any? %>
    <% rendered_any = true %>
    <%# Only label this section when curated lists also appear above it. %>
    <% if @wine_lists.any? { |l| l.wine_list_items.any? { |i| i.wine.active? } } %>
      <h2 class="font-display text-2xl font-light mb-6"><%= t("menu.all_wines") %></h2>
    <% end %>
    <% all_wines.group_by(&:color).each do |color, wines| %>
      <section class="mb-10">
        <h2 class="font-display text-xl font-medium mb-4 flex items-center gap-2">
          <span class="inline-block w-3 h-3 rounded-full <%= wine_color_class(color) %>"></span>
          <%= t("owner.wines.colors.#{color}") %>
        </h2>

        <div class="space-y-3">
          <% wines.each do |wine| %>
            <%= render "wine_row", wine: wine %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>

  <% unless rendered_any %>
    <div class="text-center py-16">
      <p class="text-base-content/50"><%= t("menu.empty") %></p>
    </div>
  <% end %>

  <%# Footer %>
  <footer class="text-center mt-12 pt-6 border-t border-base-content/5">
    <p class="text-xs text-base-content/30">
      <%= t("menu.powered_by") %>
      <a href="<%= root_path %>" class="text-primary/60 hover:text-primary">aperto.wine</a>
    </p>
  </footer>
</div>
