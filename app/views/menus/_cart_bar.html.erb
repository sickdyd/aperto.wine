<%#
  Sticky bar shown across the bottom of the menu once this restaurant's cart
  holds at least one item. Fixed position, so it floats above the page
  rather than taking part in its flow — menus/show.html.erb reserves
  matching bottom padding on the page itself so the bar never covers the
  last wine row.
  Locals:
    cart       - the restaurant's Cart, already known non-empty (required)
    restaurant - the owning Restaurant, for the cart link (required)
%>
<div id="cart-bar" class="fixed inset-x-0 bottom-0 z-30 border-t border-base-content/10 bg-base-100/95 backdrop-blur">
  <div class="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
    <p class="font-body text-sm">
      <span class="font-medium"><%= t("menu.cart_bar.item_count", count: cart.item_count) %></span>
      <span class="text-base-content/50 ml-1"><%= format_cents(cart.total_cents) %></span>
    </p>
    <a href="<%= cart_path(restaurant_id: restaurant) %>" class="btn-wine btn-sm min-h-11">
      <%= t("menu.cart_bar.view_cart") %>
    </a>
  </div>
</div>
