<%# Flash banner for public, customer-facing pages, rendered once from the
    shared application layout so every public page shows notices. Owner
    pages have their own equivalent at owner/shared/_flash, rendered from
    the separate owner layout. The wrapping container only appears when
    there is something to show, so a flash-less page gets no extra
    whitespace at the top. %>
<% if notice || alert %>
  <div class="max-w-2xl mx-auto px-4 pt-6">
    <% if notice %>
      <div role="alert" class="alert alert-success text-sm mb-6">
        <%= icon "check-circle", css: "size-4" %>
        <span><%= notice %></span>
      </div>
    <% end %>
    <% if alert %>
      <div role="alert" class="alert alert-error text-sm mb-6">
        <%= icon "warning", css: "size-4" %>
        <span><%= alert %></span>
      </div>
    <% end %>
  </div>
<% end %>
