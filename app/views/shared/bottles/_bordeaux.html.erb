<%# Bordeaux bottle: straight cylindrical body, high angular shoulders, medium neck %>
<%# Locals: fill_percent (0-100), sealed (boolean), wine_color (hex), bottle_id (unique id) %>
<svg viewBox="0 0 60 180" xmlns="http://www.w3.org/2000/svg" class="bottle-svg" aria-hidden="true">
  <defs>
    <clipPath id="bottle-clip-<%= bottle_id %>">
      <%# Bottle interior shape for clipping liquid %>
      <path d="
        M 20,155
        L 20,70
        L 20,62
        L 25,58
        L 25,10
        L 35,10
        L 35,58
        L 40,62
        L 40,70
        L 40,155
        Z
      " />
    </clipPath>
  </defs>

  <%# Liquid fill (clipped to bottle interior) %>
  <% if fill_percent > 0 %>
    <% fill_y = 155 - (fill_percent / 100.0 * 95) %>
    <rect
      x="18" y="<%= fill_y %>"
      width="24" height="<%= 155 - fill_y %>"
      fill="<%= wine_color %>"
      clip-path="url(#bottle-clip-<%= bottle_id %>)"
    />
  <% end %>

  <%# Bottle outline %>
  <path d="
    M 25,8
    L 25,56
    L 19,62
    L 19,68
    L 19,156
    Q 19,162 25,162
    L 35,162
    Q 41,162 41,156
    L 41,68
    L 41,62
    L 35,56
    L 35,8
    Z
  " fill="none" stroke="#2d2d2d" stroke-width="1.5" stroke-linejoin="round" />

  <%# Cork / foil cap %>
  <% if sealed %>
    <rect x="24" y="2" width="12" height="8" rx="1" fill="#8B7355" stroke="#6B5740" stroke-width="0.5" />
    <rect x="22" y="7" width="16" height="3" rx="0.5" fill="#C0A060" stroke="#A08040" stroke-width="0.5" />
  <% end %>
</svg>
