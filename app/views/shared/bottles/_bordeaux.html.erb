<%# Bordeaux: straight cylindrical body, high pronounced shoulders, medium neck %>
<%# Real: 300mm tall, 75mm body, 29mm neck (39%), sharp curved shoulder %>
<%# SVG: 200 tall, body ~48px, neck ~18px %>
<%# Locals: fill_percent (0-100), sealed (boolean), wine_color (hex), bottle_id (unique id) %>
<svg viewBox="0 0 80 200" xmlns="http://www.w3.org/2000/svg" class="bottle-svg" aria-hidden="true">
  <defs>
    <%# Multi-stop glass gradient for depth %>
    <linearGradient id="glass-<%= bottle_id %>" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#2e4a28" stop-opacity="0.18" />
      <stop offset="15%" stop-color="#3a5a30" stop-opacity="0.08" />
      <stop offset="50%" stop-color="#4a6a40" stop-opacity="0.02" />
      <stop offset="85%" stop-color="#3a5a30" stop-opacity="0.06" />
      <stop offset="100%" stop-color="#2e4a28" stop-opacity="0.20" />
    </linearGradient>
    <%# Curved highlight for 3D glass feel %>
    <linearGradient id="shine-<%= bottle_id %>" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="white" stop-opacity="0" />
      <stop offset="14%" stop-color="white" stop-opacity="0.06" />
      <stop offset="22%" stop-color="white" stop-opacity="0.28" />
      <stop offset="28%" stop-color="white" stop-opacity="0.12" />
      <stop offset="36%" stop-color="white" stop-opacity="0.02" />
      <stop offset="100%" stop-color="white" stop-opacity="0" />
    </linearGradient>
    <%# Wine liquid gradient (darker at bottom) %>
    <linearGradient id="wine-<%= bottle_id %>" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="<%= wine_color %>" stop-opacity="0.85" />
      <stop offset="60%" stop-color="<%= wine_color %>" stop-opacity="0.95" />
      <stop offset="100%" stop-color="black" stop-opacity="0.15" />
    </linearGradient>
    <%# Bottle shape clip %>
    <clipPath id="clip-<%= bottle_id %>">
      <path d="
        M 32,24
        L 32,62
        Q 32,66 28,68
        Q 18,72 18,78
        L 17.5,184
        Q 17.5,190 24,190
        L 56,190
        Q 62.5,190 62.5,184
        L 62,78
        Q 62,72 52,68
        Q 48,66 48,62
        L 48,24
        Z
      " />
    </clipPath>
  </defs>

  <%# Base shadow %>
  <ellipse cx="40" cy="192" rx="20" ry="2" fill="black" opacity="0.06" />

  <%# Liquid fill %>
  <% if fill_percent > 0 %>
    <% liquid_top = 184 - (fill_percent / 100.0 * 108) %>
    <g clip-path="url(#clip-<%= bottle_id %>)">
      <%# Main wine body with vertical gradient %>
      <rect x="16" y="<%= liquid_top + 3 %>" width="48" height="<%= 192 - liquid_top %>" fill="<%= wine_color %>" />
      <rect x="16" y="<%= [liquid_top + 3, 140].max %>" width="48" height="<%= [192 - 140, 192 - liquid_top].min %>" fill="black" opacity="0.06" />
      <%# Meniscus curve with ripple animation on open bottles %>
      <path d="M 17,<%= liquid_top + 3 %> Q 40,<%= liquid_top %> 63,<%= liquid_top + 3 %>" fill="<%= wine_color %>" />
      <path d="M 22,<%= liquid_top + 3 %> Q 40,<%= liquid_top + 1 %> 58,<%= liquid_top + 3 %>" fill="none" stroke="white" stroke-width="0.4" opacity="0.3" />
      <%# Edge darkening for depth %>
      <rect x="16" y="<%= liquid_top %>" width="4" height="<%= 192 - liquid_top %>" fill="black" opacity="0.10" />
      <rect x="60" y="<%= liquid_top %>" width="4" height="<%= 192 - liquid_top %>" fill="black" opacity="0.06" />
    </g>
  <% end %>

  <%# Glass body — slight taper (real Bordeaux isn't perfectly straight) %>
  <path d="
    M 32,22
    L 32,62
    Q 32,66 28,68
    Q 17,72 17,78
    L 17,184
    Q 17,191 24,191
    L 56,191
    Q 63,191 63,184
    L 63,78
    Q 63,72 52,68
    Q 48,66 48,62
    L 48,22
    Z
  " fill="url(#glass-<%= bottle_id %>)" stroke="#666" stroke-width="0.9" stroke-linejoin="round" />

  <%# Inner edge shadow (left) %>
  <path d="M 17,78 L 17,184 Q 17,191 24,191" fill="none" stroke="#2e4a28" stroke-width="0.6" opacity="0.12" />
  <%# Inner edge shadow (right) %>
  <path d="M 63,78 L 63,184 Q 63,191 56,191" fill="none" stroke="#2e4a28" stroke-width="0.4" opacity="0.08" />

  <%# Shine highlight with pulse %>
  <path d="
    M 32,22 L 32,62 Q 32,66 28,68 Q 17,72 17,78
    L 17,184 Q 17,191 24,191 L 56,191 Q 63,191 63,184
    L 63,78 Q 63,72 52,68 Q 48,66 48,62 L 48,22 Z
  " fill="url(#shine-<%= bottle_id %>)" />

  <%# Label with shadow %>
  <rect x="24" y="117" width="32" height="40" rx="1.5" fill="black" opacity="0.03" />
  <rect x="24" y="116" width="32" height="40" rx="1.5" fill="white" fill-opacity="0.55" stroke="#c0b8b0" stroke-width="0.35" />
  <line x1="28" y1="128" x2="52" y2="128" stroke="#d0c8c0" stroke-width="0.4" />
  <line x1="30" y1="133" x2="50" y2="133" stroke="#d0c8c0" stroke-width="0.35" />
  <line x1="32" y1="138" x2="48" y2="138" stroke="#d8d0c8" stroke-width="0.3" />

  <%# Lip ring %>
  <rect x="30.5" y="20" width="19" height="3.5" rx="1.75" fill="none" stroke="#666" stroke-width="0.8" />

  <%# Cork + foil capsule %>
  <% if sealed %>
    <%# Cork with diagonal grain %>
    <rect x="32" y="6" width="16" height="16" rx="2.5" fill="#C4A882" stroke="#A08860" stroke-width="0.6" />
    <line x1="34" y1="8" x2="36" y2="20" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <line x1="37" y1="7" x2="39" y2="21" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <line x1="40" y1="7" x2="42" y2="21" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <line x1="43" y1="8" x2="45" y2="20" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <%# Foil capsule %>
    <path d="M 29,20 L 29,30 Q 29,32 31,32 L 49,32 Q 51,32 51,30 L 51,20 Z"
      fill="#8B1A2B" fill-opacity="0.8" stroke="#6B0A1B" stroke-width="0.4" />
    <line x1="29" y1="26" x2="51" y2="26" stroke="#A82040" stroke-width="0.3" opacity="0.4" />
    <path d="M 30,21 L 30,29" stroke="white" stroke-width="0.3" opacity="0.15" />
  <% end %>
</svg>
