<%# Champagne: widest body, thick glass, deep punt, sloping shoulders %>
<%# Real: 315mm tall, 89mm body, 31mm neck (35%), heaviest, thick walls %>
<%# SVG: 200 tall, body ~56px, neck ~20px %>
<%# Locals: fill_percent (0-100), sealed (boolean), wine_color (hex), bottle_id (unique id) %>
<svg viewBox="0 0 80 200" xmlns="http://www.w3.org/2000/svg" class="bottle-svg" aria-hidden="true">
  <defs>
    <%# Darker glass for champagne (thicker glass) %>
    <linearGradient id="glass-<%= bottle_id %>" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1e3a18" stop-opacity="0.22" />
      <stop offset="15%" stop-color="#2e4a28" stop-opacity="0.10" />
      <stop offset="50%" stop-color="#3a5a30" stop-opacity="0.03" />
      <stop offset="85%" stop-color="#2e4a28" stop-opacity="0.08" />
      <stop offset="100%" stop-color="#1e3a18" stop-opacity="0.24" />
    </linearGradient>
    <linearGradient id="shine-<%= bottle_id %>" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="white" stop-opacity="0" />
      <stop offset="14%" stop-color="white" stop-opacity="0.04" />
      <stop offset="22%" stop-color="white" stop-opacity="0.22" />
      <stop offset="28%" stop-color="white" stop-opacity="0.08" />
      <stop offset="36%" stop-color="white" stop-opacity="0.02" />
      <stop offset="100%" stop-color="white" stop-opacity="0" />
    </linearGradient>
    <clipPath id="clip-<%= bottle_id %>">
      <path d="
        M 31,24
        L 31,50
        C 31,58 27,68 23,78
        C 16,90 14,96 14,104
        L 14,180
        Q 14,186 20,186
        L 60,186
        Q 66,186 66,180
        L 66,104
        C 66,96 64,90 57,78
        C 53,68 49,58 49,50
        L 49,24
        Z
      " />
    </clipPath>
  </defs>

  <%# Base shadow (wider for champagne) %>
  <ellipse cx="40" cy="190" rx="24" ry="2.5" fill="black" opacity="0.07" />

  <%# Liquid fill %>
  <% if fill_percent > 0 %>
    <% liquid_top = 180 - (fill_percent / 100.0 * 95) %>
    <g clip-path="url(#clip-<%= bottle_id %>)">
      <rect x="12" y="<%= liquid_top + 3 %>" width="56" height="<%= 188 - liquid_top %>" fill="<%= wine_color %>" />
      <rect x="12" y="<%= [liquid_top + 3, 142].max %>" width="56" height="<%= [188 - 142, 188 - liquid_top].min %>" fill="black" opacity="0.05" />
      <path d="M 14,<%= liquid_top + 3 %> Q 40,<%= liquid_top %> 66,<%= liquid_top + 3 %>" fill="<%= wine_color %>" />
      <path d="M 19,<%= liquid_top + 3 %> Q 40,<%= liquid_top + 1 %> 61,<%= liquid_top + 3 %>" fill="none" stroke="white" stroke-width="0.4" opacity="0.25" />
      <rect x="12" y="<%= liquid_top %>" width="4.5" height="<%= 188 - liquid_top %>" fill="black" opacity="0.10" />
      <rect x="63.5" y="<%= liquid_top %>" width="4.5" height="<%= 188 - liquid_top %>" fill="black" opacity="0.06" />
    </g>
  <% end %>

  <%# Glass body — thicker stroke for champagne %>
  <path d="
    M 31,22
    L 31,50
    C 31,58 27,68 23,78
    C 15,90 13,96 13,104
    L 13,180
    Q 13,188 20,188
    L 60,188
    Q 67,188 67,180
    L 67,104
    C 67,96 65,90 57,78
    C 53,68 49,58 49,50
    L 49,22
    Z
  " fill="url(#glass-<%= bottle_id %>)" stroke="#555" stroke-width="1.2" stroke-linejoin="round" />

  <%# Inner edge shadows (more pronounced for thick glass) %>
  <path d="M 13,104 L 13,180 Q 13,188 20,188" fill="none" stroke="#1e3a18" stroke-width="0.7" opacity="0.12" />
  <path d="M 67,104 L 67,180 Q 67,188 60,188" fill="none" stroke="#1e3a18" stroke-width="0.5" opacity="0.08" />

  <%# Shine with pulse %>
  <path d="
    M 31,22 L 31,50 C 31,58 27,68 23,78 C 15,90 13,96 13,104
    L 13,180 Q 13,188 20,188 L 60,188 Q 67,188 67,180
    L 67,104 C 67,96 65,90 57,78 C 53,68 49,58 49,50 L 49,22 Z
  " fill="url(#shine-<%= bottle_id %>)" />

  <%# Punt %>
  <path d="M 20,188 Q 40,180 60,188" fill="none" stroke="#555" stroke-width="0.7" />

  <%# Label %>
  <rect x="20" y="119" width="40" height="38" rx="1.5" fill="black" opacity="0.03" />
  <rect x="20" y="118" width="40" height="38" rx="1.5" fill="white" fill-opacity="0.55" stroke="#c0b8b0" stroke-width="0.35" />
  <line x1="25" y1="130" x2="55" y2="130" stroke="#d0c8c0" stroke-width="0.4" />
  <line x1="27" y1="135" x2="53" y2="135" stroke="#d0c8c0" stroke-width="0.35" />
  <line x1="29" y1="140" x2="51" y2="140" stroke="#d8d0c8" stroke-width="0.3" />

  <%# Lip ring (wider/thicker for champagne) %>
  <rect x="29" y="20" width="22" height="3.5" rx="1.75" fill="none" stroke="#555" stroke-width="1.0" />

  <%# Champagne cork (mushroom) + wire cage + foil %>
  <% if sealed %>
    <%# Mushroom cork — flares at top %>
    <path d="M 32,22 L 32,12 C 32,8 30.5,6 29.5,4 Q 29,2.5 30.5,2 L 49.5,2 Q 51,2.5 50.5,4 C 49.5,6 48,8 48,12 L 48,22 Z"
      fill="#C4A882" stroke="#A08860" stroke-width="0.6" />
    <line x1="35" y1="5" x2="36" y2="20" stroke="#B09870" stroke-width="0.3" opacity="0.35" />
    <line x1="38" y1="4" x2="39" y2="21" stroke="#B09870" stroke-width="0.3" opacity="0.35" />
    <line x1="41" y1="4" x2="42" y2="21" stroke="#B09870" stroke-width="0.3" opacity="0.35" />
    <line x1="44" y1="5" x2="45" y2="20" stroke="#B09870" stroke-width="0.3" opacity="0.35" />
    <%# Wire cage %>
    <line x1="32" y1="14" x2="27" y2="24" stroke="#aaa" stroke-width="0.5" />
    <line x1="48" y1="14" x2="53" y2="24" stroke="#aaa" stroke-width="0.5" />
    <circle cx="40" cy="4" r="3.5" fill="none" stroke="#bbb" stroke-width="0.4" />
    <%# Foil capsule %>
    <path d="M 27,20 L 27,32 Q 27,34 30,34 L 50,34 Q 53,34 53,32 L 53,20 Z"
      fill="#C8B040" fill-opacity="0.75" stroke="#A89030" stroke-width="0.4" />
    <line x1="27" y1="27" x2="53" y2="27" stroke="#D8C050" stroke-width="0.3" opacity="0.4" />
    <path d="M 28.5,21 L 28.5,31" stroke="white" stroke-width="0.3" opacity="0.12" />
  <% end %>
</svg>
