<%# Champagne: widest body, sloping shoulders, punt, mushroom cork when sealed %>
<%# Flat minimal: currentColor outline + flat liquid fill, no decoration %>
<%# Locals: fill_percent (0-100), sealed (boolean), wine_color (hex), bottle_id (unique id) %>
<% outline = "M 31,22 L 31,50 C 31,58 27,68 23,78 C 15,90 13,96 13,104 L 13,180 Q 13,188 20,188 L 60,188 Q 67,188 67,180 L 67,104 C 67,96 65,90 57,78 C 53,68 49,58 49,50 L 49,22 Z" %>
<svg viewBox="0 0 80 200" xmlns="http://www.w3.org/2000/svg" class="bottle-svg" aria-hidden="true">
  <defs>
    <clipPath id="clip-<%= bottle_id %>">
      <path d="<%= outline %>" />
    </clipPath>
  </defs>

  <% if fill_percent > 0 %>
    <% liquid_top = 180 - (fill_percent / 100.0 * 95) %>
    <rect x="0" y="<%= liquid_top %>" width="80" height="<%= 200 - liquid_top %>"
      fill="<%= wine_color %>" clip-path="url(#clip-<%= bottle_id %>)" />
  <% end %>

  <path d="<%= outline %>" fill="currentColor" fill-opacity="0.05"
    stroke="currentColor" stroke-width="2" stroke-linejoin="round" />

  <%# Punt — the one detail that distinguishes a champagne bottle %>
  <path d="M 20,188 Q 40,181 60,188" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4" />

  <% if sealed %>
    <%# Mushroom cork %>
    <path d="M 33,23 L 33,13 Q 33,9 31,7 Q 30,5 32,4 L 48,4 Q 50,5 49,7 Q 47,9 47,13 L 47,23 Z"
      fill="currentColor" opacity="0.35" />
  <% end %>
</svg>
