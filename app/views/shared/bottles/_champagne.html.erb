<%# Champagne bottle: Burgundy-like but thicker glass, wider body, heavier build %>
<%# Locals: fill_percent (0-100), sealed (boolean), wine_color (hex), bottle_id (unique id) %>
<svg viewBox="0 0 60 180" xmlns="http://www.w3.org/2000/svg" class="bottle-svg" aria-hidden="true">
  <defs>
    <clipPath id="bottle-clip-<%= bottle_id %>">
      <path d="
        M 16,155
        L 16,85
        Q 16,60 24,50
        L 25,15
        L 35,15
        L 36,50
        Q 44,60 44,85
        L 44,155
        Z
      " />
    </clipPath>
  </defs>

  <%# Liquid fill %>
  <% if fill_percent > 0 %>
    <% fill_y = 155 - (fill_percent / 100.0 * 105) %>
    <rect
      x="14" y="<%= fill_y %>"
      width="32" height="<%= 155 - fill_y %>"
      fill="<%= wine_color %>"
      clip-path="url(#bottle-clip-<%= bottle_id %>)"
    />
  <% end %>

  <%# Bottle outline — wider, heavier build %>
  <path d="
    M 25,8
    L 25,46
    Q 15,56 15,85
    L 15,156
    Q 15,164 23,164
    L 37,164
    Q 45,164 45,156
    L 45,85
    Q 45,56 35,46
    L 35,8
    Z
  " fill="none" stroke="#2d2d2d" stroke-width="1.5" stroke-linejoin="round" />

  <%# Punt (deep bottom indentation) %>
  <path d="M 22,164 Q 30,156 38,164" fill="none" stroke="#2d2d2d" stroke-width="1" />

  <%# Cork with wire cage (muselet) %>
  <% if sealed %>
    <rect x="24" y="2" width="12" height="8" rx="1.5" fill="#8B7355" stroke="#6B5740" stroke-width="0.5" />
    <%# Wire cage %>
    <line x1="24" y1="5" x2="22" y2="10" stroke="#999" stroke-width="0.5" />
    <line x1="36" y1="5" x2="38" y2="10" stroke="#999" stroke-width="0.5" />
    <line x1="30" y1="2" x2="30" y2="10" stroke="#999" stroke-width="0.5" />
    <%# Foil %>
    <rect x="21" y="8" width="18" height="4" rx="0.5" fill="#C0C0C0" stroke="#999" stroke-width="0.5" />
  <% end %>
</svg>
