<%# Burgundy bottle: wider base tapering to sloping shoulders, longer neck %>
<%# Locals: fill_percent (0-100), sealed (boolean), wine_color (hex), bottle_id (unique id) %>
<svg viewBox="0 0 60 180" xmlns="http://www.w3.org/2000/svg" class="bottle-svg" aria-hidden="true">
  <defs>
    <clipPath id="bottle-clip-<%= bottle_id %>">
      <path d="
        M 18,155
        L 18,80
        Q 18,60 24,52
        L 25,10
        L 35,10
        L 36,52
        Q 42,60 42,80
        L 42,155
        Z
      " />
    </clipPath>
  </defs>

  <%# Liquid fill %>
  <% if fill_percent > 0 %>
    <% fill_y = 155 - (fill_percent / 100.0 * 105) %>
    <rect
      x="16" y="<%= fill_y %>"
      width="28" height="<%= 155 - fill_y %>"
      fill="<%= wine_color %>"
      clip-path="url(#bottle-clip-<%= bottle_id %>)"
    />
  <% end %>

  <%# Bottle outline — sloping shoulders %>
  <path d="
    M 25,8
    L 25,48
    Q 17,58 17,80
    L 17,156
    Q 17,162 23,162
    L 37,162
    Q 43,162 43,156
    L 43,80
    Q 43,58 35,48
    L 35,8
    Z
  " fill="none" stroke="#2d2d2d" stroke-width="1.5" stroke-linejoin="round" />

  <%# Cork / foil cap %>
  <% if sealed %>
    <rect x="24" y="2" width="12" height="8" rx="1" fill="#8B7355" stroke="#6B5740" stroke-width="0.5" />
    <rect x="22" y="7" width="16" height="3" rx="0.5" fill="#C0A060" stroke="#A08040" stroke-width="0.5" />
  <% end %>
</svg>
