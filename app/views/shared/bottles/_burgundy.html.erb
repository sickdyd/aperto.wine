<%# Burgundy: wider base, gentle sloping shoulders, longer neck %>
<%# Real: 295mm tall, 82mm body, 29mm neck (35%), long gradual slope %>
<%# SVG: 200 tall, body ~52px, neck ~18px %>
<%# Locals: fill_percent (0-100), sealed (boolean), wine_color (hex), bottle_id (unique id) %>
<svg viewBox="0 0 80 200" xmlns="http://www.w3.org/2000/svg" class="bottle-svg" aria-hidden="true">
  <defs>
    <linearGradient id="glass-<%= bottle_id %>" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#2e4a28" stop-opacity="0.16" />
      <stop offset="15%" stop-color="#3a5a30" stop-opacity="0.07" />
      <stop offset="50%" stop-color="#4a6a40" stop-opacity="0.02" />
      <stop offset="85%" stop-color="#3a5a30" stop-opacity="0.05" />
      <stop offset="100%" stop-color="#2e4a28" stop-opacity="0.18" />
    </linearGradient>
    <linearGradient id="shine-<%= bottle_id %>" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="white" stop-opacity="0" />
      <stop offset="14%" stop-color="white" stop-opacity="0.05" />
      <stop offset="22%" stop-color="white" stop-opacity="0.26" />
      <stop offset="28%" stop-color="white" stop-opacity="0.10" />
      <stop offset="36%" stop-color="white" stop-opacity="0.02" />
      <stop offset="100%" stop-color="white" stop-opacity="0" />
    </linearGradient>
    <clipPath id="clip-<%= bottle_id %>">
      <path d="
        M 32,24
        L 32,50
        C 32,58 28,68 24,78
        C 18,90 16,96 16,102
        L 16,184
        Q 16,190 22,190
        L 58,190
        Q 64,190 64,184
        L 64,102
        C 64,96 62,90 56,78
        C 52,68 48,58 48,50
        L 48,24
        Z
      " />
    </clipPath>
  </defs>

  <%# Base shadow %>
  <ellipse cx="40" cy="192" rx="22" ry="2" fill="black" opacity="0.06" />

  <%# Liquid fill %>
  <% if fill_percent > 0 %>
    <% liquid_top = 184 - (fill_percent / 100.0 * 100) %>
    <g clip-path="url(#clip-<%= bottle_id %>)">
      <rect x="14" y="<%= liquid_top + 3 %>" width="52" height="<%= 192 - liquid_top %>" fill="<%= wine_color %>" />
      <rect x="14" y="<%= [liquid_top + 3, 145].max %>" width="52" height="<%= [192 - 145, 192 - liquid_top].min %>" fill="black" opacity="0.05" />
      <path d="M 16,<%= liquid_top + 3 %> Q 40,<%= liquid_top %> 64,<%= liquid_top + 3 %>" fill="<%= wine_color %>" />
      <path d="M 20,<%= liquid_top + 3 %> Q 40,<%= liquid_top + 1 %> 60,<%= liquid_top + 3 %>" fill="none" stroke="white" stroke-width="0.4" opacity="0.3" />
      <rect x="14" y="<%= liquid_top %>" width="4" height="<%= 192 - liquid_top %>" fill="black" opacity="0.09" />
      <rect x="62" y="<%= liquid_top %>" width="4" height="<%= 192 - liquid_top %>" fill="black" opacity="0.05" />
    </g>
  <% end %>

  <%# Glass body %>
  <path d="
    M 32,22
    L 32,50
    C 32,58 28,68 24,78
    C 17,90 15,96 15,102
    L 15,184
    Q 15,191 22,191
    L 58,191
    Q 65,191 65,184
    L 65,102
    C 65,96 63,90 56,78
    C 52,68 48,58 48,50
    L 48,22
    Z
  " fill="url(#glass-<%= bottle_id %>)" stroke="#666" stroke-width="0.9" stroke-linejoin="round" />

  <%# Inner edge shadows %>
  <path d="M 15,102 L 15,184 Q 15,191 22,191" fill="none" stroke="#2e4a28" stroke-width="0.5" opacity="0.10" />
  <path d="M 65,102 L 65,184 Q 65,191 58,191" fill="none" stroke="#2e4a28" stroke-width="0.4" opacity="0.07" />

  <%# Shine with pulse %>
  <path d="
    M 32,22 L 32,50 C 32,58 28,68 24,78 C 17,90 15,96 15,102
    L 15,184 Q 15,191 22,191 L 58,191 Q 65,191 65,184
    L 65,102 C 65,96 63,90 56,78 C 52,68 48,58 48,50 L 48,22 Z
  " fill="url(#shine-<%= bottle_id %>)" />

  <%# Label with shadow %>
  <rect x="22" y="119" width="36" height="40" rx="1.5" fill="black" opacity="0.03" />
  <rect x="22" y="118" width="36" height="40" rx="1.5" fill="white" fill-opacity="0.55" stroke="#c0b8b0" stroke-width="0.35" />
  <line x1="27" y1="130" x2="53" y2="130" stroke="#d0c8c0" stroke-width="0.4" />
  <line x1="29" y1="135" x2="51" y2="135" stroke="#d0c8c0" stroke-width="0.35" />
  <line x1="31" y1="140" x2="49" y2="140" stroke="#d8d0c8" stroke-width="0.3" />

  <%# Lip ring %>
  <rect x="30.5" y="20" width="19" height="3.5" rx="1.75" fill="none" stroke="#666" stroke-width="0.8" />

  <%# Cork + foil %>
  <% if sealed %>
    <rect x="32" y="6" width="16" height="16" rx="2.5" fill="#C4A882" stroke="#A08860" stroke-width="0.6" />
    <line x1="34" y1="8" x2="36" y2="20" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <line x1="37" y1="7" x2="39" y2="21" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <line x1="40" y1="7" x2="42" y2="21" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <line x1="43" y1="8" x2="45" y2="20" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <path d="M 29,20 L 29,30 Q 29,32 31,32 L 49,32 Q 51,32 51,30 L 51,20 Z"
      fill="#E8D5A0" fill-opacity="0.8" stroke="#C8B580" stroke-width="0.4" />
    <line x1="29" y1="26" x2="51" y2="26" stroke="#D8C590" stroke-width="0.3" opacity="0.4" />
    <path d="M 30,21 L 30,29" stroke="white" stroke-width="0.3" opacity="0.15" />
  <% end %>
</svg>
