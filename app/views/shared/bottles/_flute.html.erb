<%# Flute (Alsace): tall, slender, very gentle slope, long neck, no punt %>
<%# Real: 350mm tall, 73mm body, 29mm neck (40%), tallest/slimmest %>
<%# SVG: 200 tall, body ~40px, neck ~16px %>
<%# Locals: fill_percent (0-100), sealed (boolean), wine_color (hex), bottle_id (unique id) %>
<svg viewBox="0 0 80 200" xmlns="http://www.w3.org/2000/svg" class="bottle-svg" aria-hidden="true">
  <defs>
    <linearGradient id="glass-<%= bottle_id %>" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#2e4a28" stop-opacity="0.14" />
      <stop offset="15%" stop-color="#3a5a30" stop-opacity="0.06" />
      <stop offset="50%" stop-color="#4a6a40" stop-opacity="0.01" />
      <stop offset="85%" stop-color="#3a5a30" stop-opacity="0.04" />
      <stop offset="100%" stop-color="#2e4a28" stop-opacity="0.16" />
    </linearGradient>
    <linearGradient id="shine-<%= bottle_id %>" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="white" stop-opacity="0" />
      <stop offset="16%" stop-color="white" stop-opacity="0.05" />
      <stop offset="24%" stop-color="white" stop-opacity="0.24" />
      <stop offset="30%" stop-color="white" stop-opacity="0.10" />
      <stop offset="38%" stop-color="white" stop-opacity="0.02" />
      <stop offset="100%" stop-color="white" stop-opacity="0" />
    </linearGradient>
    <clipPath id="clip-<%= bottle_id %>">
      <path d="
        M 33,24
        L 33,52
        C 33,60 30,70 27,80
        C 22,92 21,98 21,104
        L 21,184
        Q 21,190 26,190
        L 54,190
        Q 59,190 59,184
        L 59,104
        C 59,98 58,92 53,80
        C 50,70 47,60 47,52
        L 47,24
        Z
      " />
    </clipPath>
  </defs>

  <%# Base shadow %>
  <ellipse cx="40" cy="192" rx="16" ry="1.5" fill="black" opacity="0.06" />

  <%# Liquid fill %>
  <% if fill_percent > 0 %>
    <% liquid_top = 184 - (fill_percent / 100.0 * 86) %>
    <g clip-path="url(#clip-<%= bottle_id %>)">
      <rect x="19" y="<%= liquid_top + 3 %>" width="42" height="<%= 192 - liquid_top %>" fill="<%= wine_color %>" />
      <rect x="19" y="<%= [liquid_top + 3, 148].max %>" width="42" height="<%= [192 - 148, 192 - liquid_top].min %>" fill="black" opacity="0.05" />
      <path d="M 21,<%= liquid_top + 3 %> Q 40,<%= liquid_top %> 59,<%= liquid_top + 3 %>" fill="<%= wine_color %>" />
      <path d="M 25,<%= liquid_top + 3 %> Q 40,<%= liquid_top + 1 %> 55,<%= liquid_top + 3 %>" fill="none" stroke="white" stroke-width="0.4" opacity="0.25" />
      <rect x="19" y="<%= liquid_top %>" width="3.5" height="<%= 192 - liquid_top %>" fill="black" opacity="0.09" />
      <rect x="57.5" y="<%= liquid_top %>" width="3.5" height="<%= 192 - liquid_top %>" fill="black" opacity="0.05" />
    </g>
  <% end %>

  <%# Glass body %>
  <path d="
    M 33,22
    L 33,52
    C 33,60 30,70 27,80
    C 21,92 20,98 20,104
    L 20,184
    Q 20,191 26,191
    L 54,191
    Q 60,191 60,184
    L 60,104
    C 60,98 59,92 53,80
    C 50,70 47,60 47,52
    L 47,22
    Z
  " fill="url(#glass-<%= bottle_id %>)" stroke="#666" stroke-width="0.9" stroke-linejoin="round" />

  <%# Inner edge shadows %>
  <path d="M 20,104 L 20,184 Q 20,191 26,191" fill="none" stroke="#2e4a28" stroke-width="0.5" opacity="0.10" />
  <path d="M 60,104 L 60,184 Q 60,191 54,191" fill="none" stroke="#2e4a28" stroke-width="0.4" opacity="0.07" />

  <%# Shine with pulse %>
  <path d="
    M 33,22 L 33,52 C 33,60 30,70 27,80 C 21,92 20,98 20,104
    L 20,184 Q 20,191 26,191 L 54,191 Q 60,191 60,184
    L 60,104 C 60,98 59,92 53,80 C 50,70 47,60 47,52 L 47,22 Z
  " fill="url(#shine-<%= bottle_id %>)" />

  <%# Label %>
  <rect x="25" y="123" width="30" height="36" rx="1.5" fill="black" opacity="0.03" />
  <rect x="25" y="122" width="30" height="36" rx="1.5" fill="white" fill-opacity="0.55" stroke="#c0b8b0" stroke-width="0.35" />
  <line x1="29" y1="133" x2="51" y2="133" stroke="#d0c8c0" stroke-width="0.4" />
  <line x1="31" y1="138" x2="49" y2="138" stroke="#d0c8c0" stroke-width="0.35" />
  <line x1="33" y1="143" x2="47" y2="143" stroke="#d8d0c8" stroke-width="0.3" />

  <%# Lip ring %>
  <rect x="31.5" y="20" width="17" height="3" rx="1.5" fill="none" stroke="#666" stroke-width="0.8" />

  <%# Cork + foil %>
  <% if sealed %>
    <rect x="33" y="6" width="14" height="16" rx="2" fill="#C4A882" stroke="#A08860" stroke-width="0.6" />
    <line x1="35" y1="8" x2="37" y2="20" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <line x1="38" y1="7" x2="40" y2="21" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <line x1="41" y1="7" x2="43" y2="21" stroke="#B09870" stroke-width="0.3" opacity="0.4" />
    <path d="M 30,20 L 30,29 Q 30,31 32,31 L 48,31 Q 50,31 50,29 L 50,20 Z"
      fill="#E8D5A0" fill-opacity="0.8" stroke="#C8B580" stroke-width="0.4" />
    <line x1="30" y1="25" x2="50" y2="25" stroke="#D8C590" stroke-width="0.3" opacity="0.4" />
    <path d="M 31,21 L 31,28" stroke="white" stroke-width="0.3" opacity="0.15" />
  <% end %>
</svg>
