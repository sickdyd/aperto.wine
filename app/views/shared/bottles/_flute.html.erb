<%# Flute (Alsace): tall, slender, very gentle slope, long neck %>
<%# Flat minimal: currentColor outline + flat liquid fill, no decoration %>
<%# Locals: fill_percent (0-100), sealed (boolean), wine_color (hex), bottle_id (unique id) %>
<% outline = "M 33,22 L 33,52 C 33,60 30,70 27,80 C 21,92 20,98 20,104 L 20,184 Q 20,191 26,191 L 54,191 Q 60,191 60,184 L 60,104 C 60,98 59,92 53,80 C 50,70 47,60 47,52 L 47,22 Z" %>
<svg viewBox="0 0 80 200" xmlns="http://www.w3.org/2000/svg" class="bottle-svg" aria-hidden="true">
  <defs>
    <clipPath id="clip-<%= bottle_id %>">
      <path d="<%= outline %>" />
    </clipPath>
  </defs>

  <% if fill_percent > 0 %>
    <% liquid_top = 184 - (fill_percent / 100.0 * 86) %>
    <rect x="0" y="<%= liquid_top %>" width="80" height="<%= 200 - liquid_top %>"
      fill="<%= wine_color %>" clip-path="url(#clip-<%= bottle_id %>)" />
  <% end %>

  <path d="<%= outline %>" fill="currentColor" fill-opacity="0.05"
    stroke="currentColor" stroke-width="2" stroke-linejoin="round" />

  <% if sealed %>
    <rect x="34.5" y="9" width="11" height="14" rx="1.5" fill="currentColor" opacity="0.35" />
  <% end %>
</svg>
